<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.translogix.client.controller.dispatcher.DispatcherSidebarController"
      styleClass="sidebar" spacing="8">

    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 22px 20px; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 0 0 1px 0;">
        <StackPane style="-fx-background-color: #2563eb; -fx-background-radius: 10px; -fx-min-width: 40px; -fx-min-height: 40px;">
            <Label text="TL" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;"/>
        </StackPane>
        <VBox>
            <Label text="Dispatcher Desk" styleClass="sidebar-brand-title"/>
            <Label text="TRANSLOGIX · EXPLOITATION" styleClass="sidebar-brand-sub"/>
        </VBox>
    </HBox>

    <VBox style="-fx-padding: 12px 16px;">
        <HBox styleClass="profile-card" alignment="CENTER_LEFT" spacing="12">
            <Label text="KA" styleClass="avatar-circle"/>
            <VBox HBox.hgrow="ALWAYS">
                <Label text="K. Alami" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                <Label text="Chef Répartiteur / Dispatcher" style="-fx-text-fill: #94a3b8; -fx-font-size: 10px;"/>
            </VBox>
            <Region style="-fx-background-color: #34d399; -fx-background-radius: 50%; -fx-min-width: 8px; -fx-min-height: 8px;"/>
        </HBox>
    </VBox>

    <VBox spacing="4" VBox.vgrow="ALWAYS" style="-fx-padding: 0 12px;">
        <Label text="POSTE DE COMMANDE" styleClass="eyebrow-dark" style="-fx-padding: 4px 12px 8px 12px;"/>

        <Button fx:id="btnOrders" maxWidth="Infinity" styleClass="nav-btn, nav-btn-active" onAction="#onSelectOrders">
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="10" prefWidth="210">
                    <Label text="🚛 Ordres &amp; Trajets" style="-fx-text-fill: inherit; -fx-font-size: 13px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="6 en cours" styleClass="nav-badge-blue"/>
                </HBox>
            </graphic>
        </Button>

        <Button fx:id="btnFleetGps" text="📍  Suivi Flotte &amp; GPS" maxWidth="Infinity" styleClass="nav-btn" onAction="#onSelectFleetGps"/>
        <Button fx:id="btnDriverPlanning" text="📅  Planning Chauffeurs" maxWidth="Infinity" styleClass="nav-btn" onAction="#onSelectDriverPlanning"/>

        <Button fx:id="btnIncidents" maxWidth="Infinity" styleClass="nav-btn" onAction="#onSelectIncidents">
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="10" prefWidth="210">
                    <Label text="⚠️ Incidents &amp; Alertes" style="-fx-text-fill: inherit; -fx-font-size: 13px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="2" styleClass="nav-badge-red"/>
                </HBox>
            </graphic>
        </Button>

        <Button fx:id="btnFuelLogs" text="⛽  Carburant &amp; Bons" maxWidth="Infinity" styleClass="nav-btn" onAction="#onSelectFuelLogs"/>

        <VBox styleClass="liaison-box" spacing="4">
            <VBox.margin><Insets top="18"/></VBox.margin>
            <Label text="📡 Liaison Chauffeurs" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;"/>
            <Label text="Transmettez les ordres de mission directement aux téléphones des conducteurs." wrapText="true"
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 10px;"/>
        </VBox>
    </VBox>

    <VBox style="-fx-padding: 14px 16px; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1px 0 0 0;" spacing="6">
        <Button text="🚪  Déconnexion" maxWidth="Infinity" styleClass="logout-btn" onAction="#onLogout"/>
        <Label text="Dispatcher Desk v2.0 · TransLogix" style="-fx-text-fill: #475569; -fx-font-size: 10px; -fx-padding: 0 12px;"/>
    </VBox>
</VBox>
