<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- "Rapports & analytics": choose a report, filter it (period, client, status), preview it, export it as CSV.
     All data is real, read through RapportService. Columns are built from the report headers. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.admin.RapportsController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <VBox spacing="6">
        <Label text="PILOTAGE &amp; INDICATEURS" styleClass="eyebrow"/>
        <Label text="Rapports &amp; analytics" styleClass="section-heading"/>
        <Label text="Choisissez un rapport, filtrez-le puis exportez-le en CSV." styleClass="muted"/>
    </VBox>

    <VBox styleClass="panel-padded" spacing="10">
        <Label text="Filtres" styleClass="panel-title"/>
        <FlowPane hgap="14" vgap="10">
            <VBox spacing="4">
                <Label text="Rapport" styleClass="form-label"/>
                <ComboBox fx:id="choixRapport" prefWidth="260" styleClass="form-combo"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Du" styleClass="form-label"/>
                <DatePicker fx:id="du" promptText="jj/mm/aaaa" prefWidth="150"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Au" styleClass="form-label"/>
                <DatePicker fx:id="au" promptText="jj/mm/aaaa" prefWidth="150"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Client" styleClass="form-label"/>
                <ComboBox fx:id="choixClient" prefWidth="220" styleClass="form-combo"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Statut" styleClass="form-label"/>
                <ComboBox fx:id="choixStatut" prefWidth="170" styleClass="form-combo"/>
            </VBox>
            <VBox spacing="4">
                <Label text=" " styleClass="form-label"/>
                <Button text="R&#233;initialiser" onAction="#reinitialiser" styleClass="btn-secondary"/>
            </VBox>
        </FlowPane>
        <Label fx:id="erreur" styleClass="form-error" visible="false" managed="false" wrapText="true"/>
    </VBox>

    <VBox styleClass="panel" VBox.vgrow="ALWAYS">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label fx:id="titre" text="Rapport" styleClass="panel-title"/>
                <Label fx:id="resume" styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="boutonExport" text="Exporter CSV" onAction="#exporter" styleClass="btn-primary">
                <graphic>
                    <SVGPath content="M11 3h2v9l3.5-3.5l1.4 1.4L12 15.8l-5.9-5.9l1.4-1.4L11 12z M4 18h16v2H4z" styleClass="btn-icon-white"/>
                </graphic>
            </Button>
        </HBox>
        <TableView fx:id="table" fixedCellSize="44" prefHeight="420" VBox.vgrow="ALWAYS" styleClass="flat-table">
            <placeholder>
                <Label text="Aucune ligne ne correspond aux filtres." styleClass="empty-placeholder"/>
            </placeholder>
        </TableView>
    </VBox>

    <Label text="Fichiers CSV en UTF-8, s&#233;parateur point-virgule : ils s'ouvrent directement dans Excel. Les montants sont &#233;crits sans s&#233;parateur de milliers pour rester des nombres." wrapText="true" styleClass="muted"/>
</VBox>
