<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- "Rapports & analytics" from admine.html: 3 report cards, each exports a CSV.
     Rentabilite and gazole are DEMO data (chip + file name); the RH card exports the real user accounts. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.admin.RapportsController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <VBox spacing="6">
        <Label text="PILOTAGE &amp; INDICATEURS" styleClass="eyebrow"/>
        <Label text="Rapports &amp; analytics" styleClass="section-heading"/>
        <Label text="Pr&#233;parez des exports CSV &#224; partir des donn&#233;es de l'application." styleClass="muted"/>
    </VBox>

    <GridPane hgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="33.33"/>
            <ColumnConstraints percentWidth="33.33"/>
            <ColumnConstraints percentWidth="33.34"/>
        </columnConstraints>

        <VBox styleClass="panel,report-card" spacing="12" GridPane.columnIndex="0">
            <HBox alignment="TOP_LEFT">
                <StackPane styleClass="report-icon-orange"><SVGPath content="M5 2h10l5 5v15H5z M8 10h9v2H8z M8 14h9v2H8z M8 18h6v1.5H8z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="D&#201;MO" styleClass="chip-demo"/>
            </HBox>
            <Label text="Rentabilit&#233; mensuelle" styleClass="report-title"/>
            <Label text="Synth&#232;se du chiffre d'affaires, des d&#233;penses et des marges estim&#233;es. Valeurs de d&#233;monstration en attendant le module comptable." wrapText="true" styleClass="report-text"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Exporter CSV" onAction="#exporterRentabilite" maxWidth="Infinity" styleClass="btn-primary">
                <graphic>
                    <SVGPath content="M11 3h2v9l3.5-3.5l1.4 1.4L12 15.8l-5.9-5.9l1.4-1.4L11 12z M4 18h16v2H4z" styleClass="btn-icon-white"/>
                </graphic>
            </Button>
        </VBox>

        <VBox styleClass="panel,report-card" spacing="12" GridPane.columnIndex="1">
            <HBox alignment="TOP_LEFT">
                <StackPane styleClass="report-icon-sky"><SVGPath content="M3 3h10v18H3z M5 5v5h6V5z M14 7l1.4-1.4l3.6 3.6v8.3a2.5 2.5 0 0 1-5 0V13h-1v-2h3v6.5a0.5 0.5 0 0 0 1 0v-7.5z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="D&#201;MO" styleClass="chip-demo"/>
            </HBox>
            <Label text="Consommation de gazole" styleClass="report-title"/>
            <Label text="Vue de d&#233;monstration des d&#233;penses de carburant par trajet, en attendant le module dispatching." wrapText="true" styleClass="report-text"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Exporter CSV" onAction="#exporterGazole" maxWidth="Infinity" styleClass="btn-secondary">
                <graphic>
                    <SVGPath content="M11 3h2v9l3.5-3.5l1.4 1.4L12 15.8l-5.9-5.9l1.4-1.4L11 12z M4 18h16v2H4z" styleClass="btn-icon"/>
                </graphic>
            </Button>
        </VBox>

        <VBox styleClass="panel,report-card" spacing="12" GridPane.columnIndex="2">
            <HBox alignment="TOP_LEFT">
                <StackPane styleClass="report-icon-green"><SVGPath content="M9 2a5 5 0 1 1 0 10a5 5 0 1 1 0-10z M1 22c0-5 3.5-8 8-8c1.6 0 3 0.4 4.2 1v7z M15 17.5l1.4-1.4l1.8 1.8l3.4-3.4l1.4 1.4l-4.8 4.8z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="Conformit&#233; RH" styleClass="report-title"/>
            <Label text="Comptes du personnel enregistr&#233;s (donn&#233;es r&#233;elles) : nom, email, r&#244;le, statut. Les permis arriveront avec le module RH." wrapText="true" styleClass="report-text"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Exporter CSV" onAction="#exporterConformiteRh" maxWidth="Infinity" styleClass="btn-secondary">
                <graphic>
                    <SVGPath content="M11 3h2v9l3.5-3.5l1.4 1.4L12 15.8l-5.9-5.9l1.4-1.4L11 12z M4 18h16v2H4z" styleClass="btn-icon"/>
                </graphic>
            </Button>
        </VBox>
    </GridPane>

    <VBox styleClass="panel-padded" spacing="8">
        <Label text="&#192; propos des rapports" styleClass="panel-title"/>
        <Label text="Les fichiers sont au format CSV (UTF-8, s&#233;parateur point-virgule) et s'ouvrent directement dans Excel. Les rapports marqu&#233;s D&#201;MO utilisent des exemples int&#233;gr&#233;s &#224; l'interface : pour des rapports financiers officiels, il faudra brancher la base de donn&#233;es et valider les calculs avec les donn&#233;es r&#233;elles de l'entreprise." wrapText="true" styleClass="report-text"/>
    </VBox>
</VBox>
