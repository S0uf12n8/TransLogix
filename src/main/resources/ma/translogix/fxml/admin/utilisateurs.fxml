<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- User accounts (real data, in-memory DAO). Styled like the directory tables of admine.html.
     The create/edit form opens in a dialog (admin/utilisateur-dialog.fxml), like the mockup's modal. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.admin.UtilisateursController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="GESTION DES ACC&#200;S" styleClass="eyebrow"/>
            <Label text="Utilisateurs" styleClass="section-heading"/>
            <Label text="Comptes, r&#244;les et acc&#232;s de l'&#233;quipe." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nouvel utilisateur" onAction="#nouveau" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
    </HBox>

    <VBox styleClass="panel">
        <VBox styleClass="panel-header" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Comptes utilisateurs" styleClass="panel-title"/>
                    <Label fx:id="compteur" text="0 compte" styleClass="panel-sub"/>
                </VBox>
            </HBox>
            <!-- Multi-criteria search: every filter is combined with the others (AND). -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="recherche" promptText="Nom, pr&#233;nom ou email..." prefWidth="260" styleClass="search-field"/>
                <ComboBox fx:id="filtreRole" prefWidth="190" styleClass="form-combo"/>
                <ComboBox fx:id="filtreStatut" prefWidth="150" styleClass="form-combo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="R&#233;initialiser" onAction="#reinitialiser" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
        <TableView fx:id="table" fixedCellSize="52" prefHeight="440" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucun utilisateur ne correspond &#224; la recherche." styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colNom" text="NOM" prefWidth="120"/>
                <TableColumn fx:id="colPrenom" text="PR&#201;NOM" prefWidth="120"/>
                <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="210"/>
                <TableColumn fx:id="colRole" text="R&#212;LE" prefWidth="150"/>
                <TableColumn fx:id="colActif" text="STATUT" prefWidth="100"/>
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="160" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
