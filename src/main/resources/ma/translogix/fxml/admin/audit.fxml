<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- "Journal d'audit" from admine.html. Real events recorded by AuditService (no seeded examples). -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.admin.AuditController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <VBox spacing="6">
        <Label text="S&#201;CURIT&#201; &amp; TRA&#199;ABILIT&#201;" styleClass="eyebrow"/>
        <Label text="Journal d'audit" styleClass="section-heading"/>
        <Label text="Historique des actions effectu&#233;es dans les modules. Journal en m&#233;moire : il repart &#224; z&#233;ro au red&#233;marrage." styleClass="muted"/>
    </VBox>

    <VBox styleClass="panel">
        <VBox styleClass="panel-header" spacing="12">
            <VBox spacing="3">
                <Label text="Activit&#233; r&#233;cente" styleClass="panel-title"/>
                <Label fx:id="compteur" text="0 &#233;v&#233;nement" styleClass="panel-sub"/>
            </VBox>
            <!-- Multi-criteria search: every filter is combined with the others (AND). -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="recherche" promptText="Rechercher dans le journal..." prefWidth="240" styleClass="search-field"/>
                <ComboBox fx:id="filtreModule" prefWidth="170" styleClass="form-combo"/>
                <ComboBox fx:id="filtreResultat" prefWidth="150" styleClass="form-combo"/>
                <Label text="Du" styleClass="form-label"/>
                <DatePicker fx:id="du" prefWidth="140"/>
                <Label text="au" styleClass="form-label"/>
                <DatePicker fx:id="au" prefWidth="140"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="R&#233;initialiser" onAction="#reinitialiser" styleClass="btn-secondary"/>
            </HBox>
            <Label fx:id="erreur" styleClass="form-error" visible="false" managed="false" wrapText="true"/>
        </VBox>
        <TableView fx:id="table" fixedCellSize="52" prefHeight="440" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label fx:id="videTexte" text="Aucune action enregistr&#233;e pour cette session." styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colDate" text="DATE &amp; HEURE" prefWidth="140"/>
                <TableColumn fx:id="colUtilisateur" text="UTILISATEUR" prefWidth="190"/>
                <TableColumn fx:id="colModule" text="MODULE" prefWidth="110"/>
                <TableColumn fx:id="colAction" text="ACTION EFFECTU&#201;E" prefWidth="320"/>
                <TableColumn fx:id="colResultat" text="R&#201;SULTAT" prefWidth="110"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
