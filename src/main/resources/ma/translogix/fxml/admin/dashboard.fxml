<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Gerant dashboard, reproduced from admine.html. Content only: the shell provides sidebar + top bar. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.admin.DashboardController"
      stylesheets="@../../css/app.css"
      spacing="24" styleClass="page">

    <!-- Header -->
    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="SYNTH&#200;SE EX&#201;CUTIVE" styleClass="eyebrow"/>
            <Label fx:id="salutation" text="Bonjour, M. Bennani" styleClass="section-heading"/>
            <Label text="Voici l'&#233;tat de vos op&#233;rations logistiques." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+   Nouvel ordre de transport" onAction="#moduleNonLivre" styleClass="btn-primary"/>
    </HBox>

    <!-- KPI cards -->
    <GridPane hgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <VBox styleClass="kpi-card" spacing="14" GridPane.columnIndex="0">
            <HBox>
                <VBox spacing="10">
                    <Label text="Chiffre d'affaires" styleClass="kpi-title"/>
                    <HBox alignment="BASELINE_LEFT" spacing="5">
                        <Label text="452 000" styleClass="kpi-value"/>
                        <Label text="MAD" styleClass="kpi-unit"/>
                    </HBox>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="icon-orange"><SVGPath content="M12 2a10 10 0 1 1 0 20a10 10 0 1 1 0-20z M12 6a6 6 0 1 0 0 12a6 6 0 1 0 0-12z M11 8h2v8h-2z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
            </HBox>
            <HBox spacing="5">
                <Label text="&#8599; +14 %" styleClass="foot-green"/>
                <Label text="vs mois dernier" styleClass="foot-muted"/>
            </HBox>
        </VBox>

        <VBox styleClass="kpi-card" spacing="14" GridPane.columnIndex="1">
            <HBox>
                <VBox spacing="10">
                    <Label text="Flotte op&#233;rationnelle" styleClass="kpi-title"/>
                    <HBox alignment="BASELINE_LEFT" spacing="5">
                        <Label text="18" styleClass="kpi-value"/>
                        <Label text="/ 22" styleClass="kpi-unit-large"/>
                    </HBox>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="icon-sky"><SVGPath content="M1 5h13v10H1z M14 8h4l4 4v3h-8z M3 17a2 2 0 1 0 4 0a2 2 0 1 0-4 0z M15 17a2 2 0 1 0 4 0a2 2 0 1 0-4 0z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
            </HBox>
            <VBox spacing="6">
                <ProgressBar progress="0.82" maxWidth="Infinity" styleClass="kpi-progress"/>
                <Label text="4 v&#233;hicules en maintenance" styleClass="foot-muted"/>
            </VBox>
        </VBox>

        <VBox styleClass="kpi-card" spacing="14" GridPane.columnIndex="2">
            <HBox>
                <VBox spacing="10">
                    <Label text="Cr&#233;ances clients" styleClass="kpi-title"/>
                    <HBox alignment="BASELINE_LEFT" spacing="5">
                        <Label text="89 400" styleClass="kpi-value"/>
                        <Label text="MAD" styleClass="kpi-unit"/>
                    </HBox>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="icon-red"><SVGPath content="M5 2h10l5 5v15H5z M8 10h9v2H8z M8 14h9v2H8z M8 18h6v1.5H8z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
            </HBox>
            <Label text="&#9679; 3 factures en retard" styleClass="foot-red"/>
        </VBox>

        <VBox styleClass="kpi-card" spacing="14" GridPane.columnIndex="3">
            <HBox>
                <VBox spacing="10">
                    <Label text="Conformit&#233; RH" styleClass="kpi-title"/>
                    <HBox alignment="BASELINE_LEFT" spacing="5">
                        <Label text="95" styleClass="kpi-value"/>
                        <Label text="\%" styleClass="kpi-unit-large"/>
                    </HBox>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="icon-green"><SVGPath content="M12 2l9 3.5v6c0 5.2-3.8 9.3-9 10.5c-5.2-1.2-9-5.3-9-10.5v-6z M10.5 15.5l-3.5-3.5l1.4-1.4l2.1 2.1l5.1-5.1l1.4 1.4z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
            </HBox>
            <Label text="&#9679; 1 permis &#224; renouveler" styleClass="foot-amber"/>
        </VBox>
    </GridPane>

    <!-- Recent trips + priority alerts -->
    <GridPane hgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="66"/>
            <ColumnConstraints percentWidth="34"/>
        </columnConstraints>

        <VBox styleClass="panel" GridPane.columnIndex="0">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Trajets r&#233;cents" styleClass="panel-title"/>
                    <Label text="Suivi des derniers ordres de transport" styleClass="panel-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Voir la flotte   &#8594;" onAction="#moduleNonLivre" styleClass="btn-secondary"/>
            </HBox>
            <TableView fx:id="tableTrajets" fixedCellSize="58" prefHeight="214" styleClass="flat-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colReference" text="R&#201;F&#201;RENCE" prefWidth="100"/>
                    <TableColumn fx:id="colChauffeur" text="CHAUFFEUR / CAMION" prefWidth="190"/>
                    <TableColumn fx:id="colTrajet" text="TRAJET" prefWidth="170"/>
                    <TableColumn fx:id="colStatut" text="STATUT" prefWidth="110"/>
                    <TableColumn fx:id="colMarge" text="MARGE ESTIM&#201;E" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="panel-padded" spacing="14" GridPane.columnIndex="1">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox spacing="3">
                    <Label text="Alertes prioritaires" styleClass="panel-title"/>
                    <Label text="&#201;l&#233;ments n&#233;cessitant votre attention" styleClass="panel-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="3 alertes" styleClass="chip-orange"/>
            </HBox>

            <HBox styleClass="alert-red" spacing="12" alignment="CENTER_LEFT">
                <StackPane styleClass="alert-icon"><SVGPath content="M2 5h20v14H2z M5 8h6v8H5z M13 9h6v1.5h-6z M13 12h6v1.5h-6z" fillRule="EVEN_ODD" styleClass="svg-red"/></StackPane>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Permis &#224; renouveler" styleClass="alert-title"/>
                    <Label text="1 permis n&#233;cessite une v&#233;rification." wrapText="true" styleClass="alert-text"/>
                </VBox>
                <Label text="&#8250;" styleClass="chevron"/>
            </HBox>

            <HBox styleClass="alert-amber" spacing="12" alignment="CENTER_LEFT">
                <StackPane styleClass="alert-icon"><SVGPath content="M5 2h10l5 5v15H5z M8 10h9v2H8z M8 14h9v2H8z M8 18h6v1.5H8z" fillRule="EVEN_ODD" styleClass="svg-amber"/></StackPane>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Factures impay&#233;es" styleClass="alert-title"/>
                    <Label text="89 400 MAD &#224; suivre." wrapText="true" styleClass="alert-text"/>
                </VBox>
                <Label text="&#8250;" styleClass="chevron"/>
            </HBox>

            <HBox styleClass="alert-sky" spacing="12" alignment="CENTER_LEFT">
                <StackPane styleClass="alert-icon"><SVGPath content="M14.5 2.5a5 5 0 0 0-4.8 6.4L2.5 16.1l3.4 3.4l7.2-7.2a5 5 0 0 0 6.4-4.8l-2.9 2.9l-2.8-0.7l-0.7-2.8z" fillRule="EVEN_ODD" styleClass="svg-sky"/></StackPane>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Maintenance flotte" styleClass="alert-title"/>
                    <Label text="4 v&#233;hicules &#224; l'atelier." wrapText="true" styleClass="alert-text"/>
                </VBox>
                <Label text="&#8250;" styleClass="chevron"/>
            </HBox>
        </VBox>
    </GridPane>

    <Label text="&#169; 2026 Translogix ERP &#183; Interface de d&#233;monstration" styleClass="footer" maxWidth="Infinity"/>
</VBox>
