<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<!-- Gerant dashboard, reproduced from admine.html. Content only: the shell provides sidebar + top bar.
     Answers "money, fleet, risk". Charts are filled by DashboardService (demo today, labelled), audit panel is real. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.admin.DashboardController"
      stylesheets="@../../css/app.css"
      spacing="24" styleClass="page">

    <!-- Header -->
    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="SYNTH&#200;SE EX&#201;CUTIVE" styleClass="eyebrow"/>
            <Label fx:id="salutation" text="Bonjour, M. Bennani" styleClass="section-heading"/>
            <Label text="Voici l'&#233;tat de vos op&#233;rations logistiques." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nouvel ordre de transport" onAction="#ouvrirDispatching" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
    </HBox>

    <!-- KPI cards. The Circle is the tinted decoration of the mockup (.kpi:after), clipped by the controller. -->
    <GridPane hgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <StackPane fx:id="kpiChiffre" styleClass="kpi-card" GridPane.columnIndex="0">
            <Circle radius="45" styleClass="kpi-decor-orange" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="14">
                <HBox>
                    <VBox spacing="10">
                        <Label text="Chiffre d'affaires" styleClass="kpi-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="5">
                            <Label text="452 000" styleClass="kpi-value"/>
                            <Label text="MAD" styleClass="kpi-unit"/>
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="icon-orange"><SVGPath content="M12 2a10 10 0 1 1 0 20a10 10 0 1 1 0-20z M12 6a6 6 0 1 0 0 12a6 6 0 1 0 0-12z M11 8h2v8h-2z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
                </HBox>
                <HBox spacing="5">
                    <Label text="&#8599; +14 %" styleClass="foot-green"/>
                    <Label text="vs mois dernier" styleClass="foot-muted"/>
                </HBox>
            </VBox>
        </StackPane>

        <StackPane fx:id="kpiFlotte" styleClass="kpi-card" GridPane.columnIndex="1">
            <Circle radius="45" styleClass="kpi-decor-sky" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="14">
                <HBox>
                    <VBox spacing="10">
                        <Label text="Flotte op&#233;rationnelle" styleClass="kpi-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="5">
                            <Label text="18" styleClass="kpi-value"/>
                            <Label text="/ 22" styleClass="kpi-unit-large"/>
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="icon-sky"><SVGPath content="M1 5h13v10H1z M14 8h4l4 4v3h-8z M3 17a2 2 0 1 0 4 0a2 2 0 1 0-4 0z M15 17a2 2 0 1 0 4 0a2 2 0 1 0-4 0z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
                </HBox>
                <VBox spacing="6">
                    <ProgressBar progress="0.82" maxWidth="Infinity" styleClass="kpi-progress"/>
                    <Label text="4 v&#233;hicules en maintenance" styleClass="foot-muted"/>
                </VBox>
            </VBox>
        </StackPane>

        <StackPane fx:id="kpiCreances" styleClass="kpi-card" GridPane.columnIndex="2">
            <Circle radius="45" styleClass="kpi-decor-red" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="14">
                <HBox>
                    <VBox spacing="10">
                        <Label text="Cr&#233;ances clients" styleClass="kpi-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="5">
                            <Label text="89 400" styleClass="kpi-value"/>
                            <Label text="MAD" styleClass="kpi-unit"/>
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="icon-red"><SVGPath content="M5 2h10l5 5v15H5z M8 10h9v2H8z M8 14h9v2H8z M8 18h6v1.5H8z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
                </HBox>
                <Label text="&#9679; 3 factures en retard" styleClass="foot-red"/>
            </VBox>
        </StackPane>

        <StackPane fx:id="kpiConformite" styleClass="kpi-card" GridPane.columnIndex="3">
            <Circle radius="45" styleClass="kpi-decor-green" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="14">
                <HBox>
                    <VBox spacing="10">
                        <Label text="Conformit&#233; RH" styleClass="kpi-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="5">
                            <Label text="95" styleClass="kpi-value"/>
                            <Label text="\%" styleClass="kpi-unit-large"/>
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="icon-green"><SVGPath content="M12 2l9 3.5v6c0 5.2-3.8 9.3-9 10.5c-5.2-1.2-9-5.3-9-10.5v-6z M10.5 15.5l-3.5-3.5l1.4-1.4l2.1 2.1l5.1-5.1l1.4 1.4z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
                </HBox>
                <Label text="&#9679; 1 permis &#224; renouveler" styleClass="foot-amber"/>
            </VBox>
        </StackPane>
    </GridPane>

    <!-- MONEY: revenue by month + missions by status (DashboardService) -->
    <GridPane hgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="64"/>
            <ColumnConstraints percentWidth="36"/>
        </columnConstraints>

        <VBox styleClass="panel" GridPane.columnIndex="0">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Chiffre d'affaires" styleClass="panel-title"/>
                        <Label fx:id="chipCa" text="D&#201;MO" styleClass="chip-demo"/>
                    </HBox>
                    <Label fx:id="sousTitreCa" text="6 derniers mois, en MAD" styleClass="panel-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalCa" styleClass="chart-total"/>
            </HBox>
            <BarChart fx:id="graphiqueCa" legendVisible="false" animated="false" prefHeight="270"
                      categoryGap="22" styleClass="dashboard-chart">
                <xAxis><CategoryAxis tickMarkVisible="false"/></xAxis>
                <yAxis><NumberAxis fx:id="axeCa" minorTickVisible="false" tickMarkVisible="false"/></yAxis>
            </BarChart>
        </VBox>

        <VBox styleClass="panel" GridPane.columnIndex="1">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Missions par statut" styleClass="panel-title"/>
                        <Label fx:id="chipMissions" text="D&#201;MO" styleClass="chip-demo"/>
                    </HBox>
                    <Label fx:id="sousTitreMissions" text="Cycle de vie des missions" styleClass="panel-sub"/>
                </VBox>
            </HBox>
            <PieChart fx:id="graphiqueMissions" legendVisible="true" labelsVisible="false" animated="false"
                      legendSide="RIGHT" prefHeight="270" startAngle="90" styleClass="dashboard-chart"/>
        </VBox>
    </GridPane>

    <!-- FLEET + RISK: fleet state, priority alerts, latest audit events -->
    <GridPane hgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="33"/>
            <ColumnConstraints percentWidth="33"/>
            <ColumnConstraints percentWidth="34"/>
        </columnConstraints>

        <VBox styleClass="panel" GridPane.columnIndex="0">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="&#201;tat de la flotte" styleClass="panel-title"/>
                        <Label fx:id="chipFlotte" text="D&#201;MO" styleClass="chip-demo"/>
                    </HBox>
                    <Label fx:id="sousTitreFlotte" text="V&#233;hicules par &#233;tat" styleClass="panel-sub"/>
                </VBox>
            </HBox>
            <BarChart fx:id="graphiqueFlotte" legendVisible="false" animated="false" prefHeight="230"
                      categoryGap="18" styleClass="dashboard-chart">
                <xAxis><NumberAxis fx:id="axeFlotte" minorTickVisible="false" tickMarkVisible="false" autoRanging="false" lowerBound="0"/></xAxis>
                <yAxis><CategoryAxis tickMarkVisible="false"/></yAxis>
            </BarChart>
        </VBox>

        <VBox styleClass="panel-padded" spacing="14" GridPane.columnIndex="1">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox spacing="3">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Alertes prioritaires" styleClass="panel-title"/>
                        <Label fx:id="chipAlertes" text="D&#201;MO" styleClass="chip-demo"/>
                    </HBox>
                    <Label text="&#192; traiter en priorit&#233;" styleClass="panel-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="nombreAlertes" minWidth="-Infinity" styleClass="chip-orange"/>
            </HBox>
            <VBox fx:id="listeAlertes" spacing="12"/>
        </VBox>

        <VBox styleClass="panel-padded" spacing="14" GridPane.columnIndex="2">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox spacing="3">
                    <Label text="Derni&#232;res actions" styleClass="panel-title"/>
                    <Label text="Journal d'audit &#183; r&#233;el" styleClass="panel-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Journal  &#8594;" onAction="#ouvrirJournal" minWidth="-Infinity" styleClass="btn-secondary"/>
            </HBox>
            <VBox fx:id="listeAudit" spacing="10"/>
        </VBox>
    </GridPane>

    <!-- Recent trips (static DEMO rows, as in admine.html) -->
    <VBox styleClass="panel">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Trajets r&#233;cents" styleClass="panel-title"/>
                    <Label text="D&#201;MO" styleClass="chip-demo"/>
                </HBox>
                <Label text="Suivi des derniers ordres de transport" styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Voir la flotte   &#8594;" onAction="#ouvrirDispatching" styleClass="btn-secondary"/>
        </HBox>
        <TableView fx:id="tableTrajets" fixedCellSize="58" prefHeight="214" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colReference" text="R&#201;F&#201;RENCE" prefWidth="110" minWidth="80"/>
                <TableColumn fx:id="colChauffeur" text="CHAUFFEUR / CAMION" prefWidth="230" minWidth="155"/>
                <TableColumn fx:id="colTrajet" text="TRAJET" prefWidth="230" minWidth="150"/>
                <TableColumn fx:id="colStatut" text="STATUT" prefWidth="140" minWidth="100"/>
                <TableColumn fx:id="colMarge" text="MARGE ESTIM&#201;E" prefWidth="140" minWidth="105"/>
            </columns>
        </TableView>
    </VBox>

    <Label text="&#169; 2026 Translogix ERP &#183; Interface de d&#233;monstration &#183; Les donn&#233;es ne sont pas enregistr&#233;es sur un serveur." styleClass="footer" maxWidth="Infinity"/>
</VBox>
