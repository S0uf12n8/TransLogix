<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ma.translogix.controller.admin.AdminLayoutController"
            stylesheets="@../../css/app.css">
    <top>
        <HBox styleClass="banner" alignment="CENTER_LEFT" spacing="10">
            <Label text="TransLogix" styleClass="banner-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="G&#233;rant" styleClass="banner-user"/>
        </HBox>
    </top>
    <left>
        <VBox styleClass="sidebar" spacing="4">
            <Button text="Tableau de bord" onAction="#afficherTableauDeBord" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Utilisateurs" onAction="#afficherUtilisateurs" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="V&#233;hicules" disable="true" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Chauffeurs" disable="true" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Clients" disable="true" maxWidth="Infinity" styleClass="nav-button"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contenu"/>
    </center>
</BorderPane>
