<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!-- Shared banner for every role (sidebar + top bar). Pages are loaded into "contenu".
     Do not rename the fx:id values or #deconnexion: ShellController uses them. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ma.translogix.controller.common.ShellController"
            stylesheets="@../../css/app.css">
    <left>
        <VBox styleClass="sidebar" prefWidth="258" minWidth="258">
            <HBox styleClass="sidebar-brand" spacing="12" alignment="CENTER_LEFT">
                <Label text="TL" styleClass="logo-tile"/>
                <VBox spacing="3">
                    <Label text="Translogix" styleClass="brand-title"/>
                    <Label fx:id="sousTitre" text="ERP LOGISTIQUE" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <HBox styleClass="user-card" alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="initiales" text="MB" styleClass="avatar"/>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="nomUtilisateur" text="M. Bennani" styleClass="user-name"/>
                    <Label fx:id="roleUtilisateur" text="Administrateur" styleClass="user-role"/>
                </VBox>
                <Circle radius="4" styleClass="online-dot"/>
            </HBox>
            <Label text="ESPACE DE TRAVAIL" styleClass="sidebar-eyebrow"/>
            <VBox fx:id="menu" spacing="4"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="sidebar-footer" spacing="8">
                <Button text="D&#233;connexion" onAction="#deconnexion" maxWidth="Infinity" styleClass="logout"/>
                <Label text="Translogix v2.0" styleClass="version"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="3">
                        <Label fx:id="kicker" text="VUE G&#201;N&#201;RALE" styleClass="eyebrow"/>
                        <Label fx:id="titrePage" text="Tableau de bord" styleClass="topbar-title"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="3">
                        <Label fx:id="dateDuJour" styleClass="topbar-date"/>
                        <Label text="Donn&#233;es de d&#233;monstration" styleClass="topbar-meta"/>
                    </VBox>
                </HBox>
            </top>
            <center>
                <ScrollPane fitToWidth="true" styleClass="content-scroll">
                    <StackPane fx:id="contenu"/>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
