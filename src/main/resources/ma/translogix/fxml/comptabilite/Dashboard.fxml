
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.translogix.controller.comptabilite.DashboardController"
      spacing="20">

    <padding>
        <Insets top="25" right="28" bottom="28" left="28"/>
    </padding>

    <VBox spacing="5">
        <Label text="Vue générale" styleClass="section-title"/>
        <Label text="Synthèse de votre activité financière" styleClass="muted"/>
    </VBox>

    <GridPane hgap="16" vgap="16">

        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="kpi-card">
            <Label text="Chiffre d'affaires HT" styleClass="muted"/>
            <Label fx:id="caLabel" text="—" styleClass="kpi-value"/>
        </VBox>

        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="kpi-card">
            <Label text="Encaissements" styleClass="muted"/>
            <Label fx:id="encaissementsLabel" text="—" styleClass="kpi-value"/>
        </VBox>

        <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="kpi-card">
            <Label text="Créances clients" styleClass="muted"/>
            <Label fx:id="creancesLabel" text="—" styleClass="kpi-value"/>
        </VBox>

        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="kpi-card">
            <Label text="Charges" styleClass="muted"/>
            <Label fx:id="chargesLabel" text="—" styleClass="kpi-value"/>
        </VBox>

        <VBox GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="kpi-card">
            <Label text="Trésorerie" styleClass="muted"/>
            <Label fx:id="tresorerieLabel" text="—" styleClass="kpi-value"/>
        </VBox>

        <VBox GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="kpi-card">
            <Label text="Résultat net" styleClass="muted"/>
            <Label fx:id="resultatLabel" text="—" styleClass="kpi-value"/>
        </VBox>

    </GridPane>

    <VBox styleClass="panel" spacing="10">
        <Label text="Informations" styleClass="section-title"/>
        <Label text="Les montants affichés sont des données fictives de démonstration."/>
        <Label text="Les indicateurs seront connectés au backend ultérieurement."/>
    </VBox>

</VBox>
