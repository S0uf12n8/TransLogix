
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.translogix.controller.comptabilite.TVAController"
      spacing="15">

    <padding>
        <Insets top="25" right="28" bottom="28" left="28"/>
    </padding>

    <Label text="TVA et impôts" styleClass="section-title"/>

    <Label fx:id="messageLabel" text=""/>

    <Button text="Actualiser"
            onAction="#actualiser"
            styleClass="primary-button"/>

    <TableView>
        <columns>
            <TableColumn text="Période" prefWidth="130"/>
            <TableColumn text="TVA collectée" prefWidth="150"/>
            <TableColumn text="TVA déductible" prefWidth="150"/>
            <TableColumn text="Solde TVA" prefWidth="150"/>
            <TableColumn text="Statut" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>
