<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.translogix.controller.comptabilite.RecouvrementController"
      spacing="15">

    <padding>
        <Insets top="25" right="28" bottom="28" left="28"/>
    </padding>

    <Label text="Recouvrement B2B" styleClass="section-title"/>

    <Label fx:id="messageLabel" text=""/>

    <Button text="Actualiser"
            onAction="#actualiser"
            styleClass="primary-button"/>

    <TableView>
        <columns>
            <TableColumn text="N° Facture" prefWidth="120"/>
            <TableColumn text="Client" prefWidth="180"/>
            <TableColumn text="Date échéance" prefWidth="130"/>
            <TableColumn text="Montant dû" prefWidth="130"/>
            <TableColumn text="Statut" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>
