<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.translogix.controller.comptabilite.PaieController"
      spacing="15">

    <padding>
        <Insets top="25" right="28" bottom="28" left="28"/>
    </padding>

    <Label text="Paie et primes des employés" styleClass="section-title"/>

    <Label fx:id="messageLabel" text=""/>

    <Button text="Actualiser"
            onAction="#actualiser"
            styleClass="primary-button"/>

    <TableView>
        <columns>
            <TableColumn text="Employé" prefWidth="180"/>
            <TableColumn text="Période" prefWidth="120"/>
            <TableColumn text="Salaire brut" prefWidth="130"/>
            <TableColumn text="Primes" prefWidth="120"/>
            <TableColumn text="Net à payer" prefWidth="140"/>
        </columns>
    </TableView>

</VBox>
