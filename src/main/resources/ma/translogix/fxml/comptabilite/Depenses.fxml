
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.translogix.controller.comptabilite.DepensesController"
      spacing="15">

    <padding>
        <Insets top="25" right="28" bottom="28" left="28"/>
    </padding>

    <Label text="Frais et dépenses" styleClass="section-title"/>

    <Label fx:id="messageLabel" text=""/>

    <Button text="Actualiser"
            onAction="#actualiser"
            styleClass="primary-button"/>

    <TableView>
        <columns>
            <TableColumn text="Date" prefWidth="120"/>
            <TableColumn text="Catégorie" prefWidth="150"/>
            <TableColumn text="Description" prefWidth="220"/>
            <TableColumn text="Montant" prefWidth="130"/>
            <TableColumn text="Justificatif" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>
