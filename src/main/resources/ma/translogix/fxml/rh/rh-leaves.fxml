<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.rh.RhLeavesController"
      styleClass="rh-page" spacing="20">
    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="Suivi du Temps de Travail" styleClass="rh-eyebrow"/>
            <Label text="Cong&#233;s &amp; Absences" styleClass="rh-section-title"/>
            <Label text="Validation des demandes de cong&#233; pay&#233;, cong&#233;s maladie et absences." styleClass="rh-muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Nouvelle demande" onAction="#nouvelleDemande" styleClass="rh-btn-primary"/>
    </HBox>

    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox styleClass="rh-panel" HBox.hgrow="ALWAYS">
            <HBox styleClass="rh-panel-head" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Demandes R&#233;centes" styleClass="rh-panel-title"/>
                    <Label text="Validation des d&#233;parts en cong&#233;" styleClass="rh-card-hint"/>
                </VBox>
            </HBox>
            <TableView fx:id="table" styleClass="rh-table" prefHeight="260">
                <columns>
                    <TableColumn fx:id="colEmploye" text="Employ&#233;" prefWidth="170"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="200"/>
                    <TableColumn fx:id="colPeriode" text="P&#233;riode" prefWidth="190"/>
                    <TableColumn fx:id="colJours" text="Jours" prefWidth="80"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                    <TableColumn fx:id="colAction" text="Action" prefWidth="170"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="rh-panel,rh-panel-pad" spacing="16" prefWidth="320">
            <Label text="Solde des Cong&#233;s (Moyenne)" styleClass="rh-panel-title"/>
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Chauffeurs PL" styleClass="rh-kpi-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="18 j. / 21 j. restants" styleClass="rh-card-hint"/>
                </HBox>
                <ProgressBar progress="0.85" maxWidth="Infinity" styleClass="rh-progress"/>
            </VBox>
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Administration" styleClass="rh-kpi-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="14 j. / 18 j. restants" styleClass="rh-card-hint"/>
                </HBox>
                <ProgressBar progress="0.70" maxWidth="Infinity" styleClass="rh-progress"/>
            </VBox>
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT">
                    <Label text="&#201;quipe Atelier" styleClass="rh-kpi-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="12 j. / 18 j. restants" styleClass="rh-card-hint"/>
                </HBox>
                <ProgressBar progress="0.65" maxWidth="Infinity" styleClass="rh-progress"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>
