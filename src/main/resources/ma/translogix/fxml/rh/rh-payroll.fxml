<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.rh.RhPayrollController"
      styleClass="rh-page" spacing="20">
    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="R&#233;mun&#233;ration &amp; Primes Logistiques" styleClass="rh-eyebrow"/>
            <Label text="Paie &amp; Primes de Route" styleClass="rh-section-title"/>
            <Label text="Calcul des indemnit&#233;s kilom&#233;triques, primes de trajet et variables du mois." styleClass="rh-muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Calculer les Primes" onAction="#calculer" styleClass="rh-btn-primary"/>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="rh-panel,rh-panel-pad" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Masse Salariale Estim&#233;e" styleClass="rh-kpi-label"/>
            <Label text="285 000 MAD" styleClass="rh-kpi-value"/>
        </VBox>
        <VBox styleClass="rh-panel,rh-panel-pad" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Total Primes de Route (Mois)" styleClass="rh-kpi-label"/>
            <Label text="48 500 MAD" styleClass="rh-kpi-value,rh-accent"/>
        </VBox>
        <VBox styleClass="rh-panel,rh-panel-pad" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Jours Travaill&#233;s Flotte" styleClass="rh-kpi-label"/>
            <Label text="620 Journ&#233;es" styleClass="rh-kpi-value,rh-positive"/>
        </VBox>
    </HBox>

    <VBox styleClass="rh-panel">
        <HBox styleClass="rh-panel-head" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="D&#233;compte des Primes de Trajet par Chauffeur" styleClass="rh-panel-title"/>
                <Label text="Calcul bas&#233; sur la distance parcourue et le nombre de trajets accomplis." styleClass="rh-card-hint"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="recherche" promptText="Rechercher chauffeur..." styleClass="rh-input" prefWidth="240"/>
        </HBox>
        <TableView fx:id="table" styleClass="rh-table" prefHeight="260">
            <columns>
                <TableColumn fx:id="colChauffeur" text="Chauffeur" prefWidth="180"/>
                <TableColumn fx:id="colMissions" text="Missions Ce Mois" prefWidth="130"/>
                <TableColumn fx:id="colDistance" text="Distance Totale" prefWidth="130"/>
                <TableColumn fx:id="colBase" text="Salaire de Base" prefWidth="140"/>
                <TableColumn fx:id="colPrime" text="Prime de Route (MAD)" prefWidth="170"/>
                <TableColumn fx:id="colNet" text="Net Estim&#233;" prefWidth="130"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
