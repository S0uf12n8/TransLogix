<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.rh.RhComplianceController"
      styleClass="rh-page" spacing="20">
    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="S&#233;curit&#233; &amp; R&#233;glementation Transport" styleClass="rh-eyebrow"/>
            <Label text="Conformit&#233;, Permis &amp; Visites M&#233;dicales" styleClass="rh-section-title"/>
            <Label text="Suivi strict des &#233;ch&#233;ances de permis de conduire, carte FIMC/FCO et examens m&#233;dicaux." styleClass="rh-muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Mettre &#224; jour document" onAction="#renouveler" styleClass="rh-btn-primary"/>
    </HBox>

    <HBox styleClass="rh-alert-panel" alignment="CENTER_LEFT" spacing="16">
        <StackPane styleClass="rh-alert-icon"><Label text="&#9888;"/></StackPane>
        <VBox spacing="3">
            <Label text="Alerte &#201;ch&#233;ances Permis &amp; Visites M&#233;dicales" styleClass="rh-alert-title"/>
            <Label text="3 &#233;l&#233;ments n&#233;cessitent une action urgente avant suspension de la conduite." styleClass="rh-alert-text"/>
        </VBox>
    </HBox>

    <VBox styleClass="rh-panel">
        <HBox styleClass="rh-panel-head" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Registre de Conformit&#233; des Conducteurs" styleClass="rh-panel-title"/>
                <Label text="Validit&#233; des pi&#232;ces l&#233;gales obligatoires au Maroc." styleClass="rh-card-hint"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="recherche" promptText="Filtrer par chauffeur..." styleClass="rh-input" prefWidth="240"/>
        </HBox>
        <TableView fx:id="table" styleClass="rh-table" prefHeight="280">
            <columns>
                <TableColumn fx:id="colChauffeur" text="Chauffeur" prefWidth="170"/>
                <TableColumn fx:id="colNumero" text="N&#176; Permis" prefWidth="110"/>
                <TableColumn fx:id="colCategorie" text="Cat&#233;gorie" prefWidth="90"/>
                <TableColumn fx:id="colExpiration" text="Expiration Permis" prefWidth="180"/>
                <TableColumn fx:id="colFimc" text="Carte FIMC/FCO" prefWidth="160"/>
                <TableColumn fx:id="colVisite" text="Visite M&#233;dicale" prefWidth="150"/>
                <TableColumn fx:id="colStatut" text="Statut Global" prefWidth="120"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
