<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- "Congés & Absences" (rh.html leaves): Iteration 3. Majda's layout and sample rows, shown as DÉMO;
     every action says "Module pas encore livré (itération 3)". No model or service yet. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.rh.CongesController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="SUIVI DU TEMPS DE TRAVAIL" styleClass="eyebrow"/>
                <Label text="D&#201;MO" styleClass="chip-demo"/>
            </HBox>
            <Label text="Cong&#233;s &amp; Absences" styleClass="section-heading"/>
            <Label text="Validation des demandes de cong&#233; pay&#233;, cong&#233;s maladie et absences." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nouvelle demande" onAction="#nouvelleDemande" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
    </HBox>

    <GridPane hgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="76"/>
            <ColumnConstraints percentWidth="24"/>
        </columnConstraints>

        <VBox styleClass="panel" GridPane.columnIndex="0">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Demandes R&#233;centes" styleClass="panel-title"/>
                    <Label text="Validation des d&#233;parts en cong&#233; (donn&#233;es de d&#233;monstration)" styleClass="panel-sub"/>
                </VBox>
            </HBox>
            <TableView fx:id="table" fixedCellSize="52" prefHeight="240" styleClass="flat-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colEmploye" text="EMPLOY&#201;" prefWidth="140" minWidth="115" sortable="false"/>
                    <TableColumn fx:id="colType" text="TYPE" prefWidth="145" minWidth="120" sortable="false"/>
                    <TableColumn fx:id="colPeriode" text="P&#201;RIODE" prefWidth="175" minWidth="175" sortable="false"/>
                    <TableColumn fx:id="colJours" text="JOURS" prefWidth="70" minWidth="70" sortable="false"/>
                    <TableColumn fx:id="colStatut" text="STATUT" prefWidth="100" minWidth="95" sortable="false"/>
                    <TableColumn fx:id="colAction" text="ACTION" prefWidth="135" minWidth="135" sortable="false"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="card" spacing="16" GridPane.columnIndex="1">
            <Label text="Solde des Cong&#233;s (Moyenne)" styleClass="panel-title"/>
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Chauffeurs PL" styleClass="kpi-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="18 j. / 21 j. restants" styleClass="foot-muted"/>
                </HBox>
                <ProgressBar progress="0.85" maxWidth="Infinity" styleClass="kpi-progress"/>
            </VBox>
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Administration" styleClass="kpi-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="14 j. / 18 j. restants" styleClass="foot-muted"/>
                </HBox>
                <ProgressBar progress="0.70" maxWidth="Infinity" styleClass="kpi-progress"/>
            </VBox>
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT">
                    <Label text="&#201;quipe Atelier" styleClass="kpi-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="12 j. / 18 j. restants" styleClass="foot-muted"/>
                </HBox>
                <ProgressBar progress="0.65" maxWidth="Infinity" styleClass="kpi-progress"/>
            </VBox>
        </VBox>
    </GridPane>
</VBox>
