<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.rh.RhDashboardController"
      styleClass="rh-page" spacing="24">
    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="Gestion des ressources humaines" styleClass="rh-eyebrow"/>
            <Label text="Bienvenue, Mme. Chra&#239;bi &#128075;" styleClass="rh-section-title"/>
            <Label text="Aper&#231;u global de l'effectif, de la conformit&#233; et des demandes RH." styleClass="rh-muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Exporter Rapport RH" onAction="#exporter" styleClass="rh-btn-secondary"/>
    </HBox>

    <GridPane hgap="16" vgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <VBox styleClass="rh-panel,rh-panel-pad" GridPane.columnIndex="0" spacing="12">
            <HBox spacing="10">
                <VBox spacing="6">
                    <Label text="Effectif Total" styleClass="rh-kpi-label"/>
                    <Label text="42 salari&#233;s" styleClass="rh-kpi-value"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="rh-kpi-icon,rh-tint-orange"><Label text="&#128101;"/></StackPane>
            </HBox>
            <Label text="+3 recrutements ce mois" styleClass="rh-kpi-foot,rh-positive"/>
        </VBox>

        <VBox styleClass="rh-panel,rh-panel-pad" GridPane.columnIndex="1" spacing="12">
            <HBox spacing="10">
                <VBox spacing="6">
                    <Label text="Chauffeurs Actifs" styleClass="rh-kpi-label"/>
                    <Label text="28 / 30" styleClass="rh-kpi-value"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="rh-kpi-icon,rh-tint-blue"><Label text="&#129297;"/></StackPane>
            </HBox>
            <ProgressBar progress="0.93" maxWidth="Infinity" styleClass="rh-progress"/>
            <Label text="2 chauffeurs en cong&#233;" styleClass="rh-card-hint"/>
        </VBox>

        <VBox styleClass="rh-panel,rh-panel-pad" GridPane.columnIndex="2" spacing="12">
            <HBox spacing="10">
                <VBox spacing="6">
                    <Label text="Alertes Conformit&#233;" styleClass="rh-kpi-label"/>
                    <Label text="3 dossiers" styleClass="rh-kpi-value"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="rh-kpi-icon,rh-tint-red"><Label text="&#9888;"/></StackPane>
            </HBox>
            <Label text="2 Permis + 1 Visite M&#233;dicale" styleClass="rh-kpi-foot,rh-negative"/>
        </VBox>

        <VBox styleClass="rh-panel,rh-panel-pad" GridPane.columnIndex="3" spacing="12">
            <HBox spacing="10">
                <VBox spacing="6">
                    <Label text="Cong&#233;s en Attente" styleClass="rh-kpi-label"/>
                    <Label text="2 demandes" styleClass="rh-kpi-value"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="rh-kpi-icon,rh-tint-green"><Label text="&#128197;"/></StackPane>
            </HBox>
            <Label text="&#192; valider sous 48h" styleClass="rh-kpi-foot,rh-warning"/>
        </VBox>
    </GridPane>

    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox styleClass="rh-panel" HBox.hgrow="ALWAYS">
            <HBox styleClass="rh-panel-head" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Chauffeurs &amp; Conducteurs - Statut Rapide" styleClass="rh-panel-title"/>
                    <Label text="Derniers mouvements et &#233;tats de service" styleClass="rh-card-hint"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Voir l'annuaire complet" onAction="#voirAnnuaire" styleClass="rh-btn-secondary"/>
            </HBox>
            <TableView fx:id="tableConducteurs" styleClass="rh-table" prefHeight="220">
                <columns>
                    <TableColumn fx:id="colEmploye" text="Employ&#233;" prefWidth="180"/>
                    <TableColumn fx:id="colPoste" text="Poste / Cat&#233;gorie" prefWidth="190"/>
                    <TableColumn fx:id="colPermis" text="Permis / FIMC" prefWidth="150"/>
                    <TableColumn fx:id="colVisite" text="Visite M&#233;dicale" prefWidth="150"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="rh-panel,rh-panel-pad" spacing="14" prefWidth="320">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Action Rapide RH" styleClass="rh-panel-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Aujourd'hui" styleClass="rh-chip"/>
            </HBox>
            <Button maxWidth="Infinity" onAction="#saisirConge" styleClass="rh-action,rh-action-orange">
                <graphic>
                    <VBox alignment="CENTER_LEFT" spacing="3">
                        <Label text="Saisir une demande de cong&#233;" styleClass="rh-action-title"/>
                        <Label text="Saisie rapide pour un salari&#233;." styleClass="rh-action-sub"/>
                    </VBox>
                </graphic>
            </Button>
            <Button maxWidth="Infinity" onAction="#renouvelerDocument" styleClass="rh-action,rh-action-blue">
                <graphic>
                    <VBox alignment="CENTER_LEFT" spacing="3">
                        <Label text="Renouvellement Permis / FIMC" styleClass="rh-action-title"/>
                        <Label text="Mettre &#224; jour une visite m&#233;dicale ou carte FCO." styleClass="rh-action-sub"/>
                    </VBox>
                </graphic>
            </Button>
            <Button maxWidth="Infinity" onAction="#ouvrirPaie" styleClass="rh-action,rh-action-purple">
                <graphic>
                    <VBox alignment="CENTER_LEFT" spacing="3">
                        <Label text="Calculateur Prime Route" styleClass="rh-action-title"/>
                        <Label text="G&#233;n&#233;rer les indemnit&#233;s de d&#233;placement." styleClass="rh-action-sub"/>
                    </VBox>
                </graphic>
            </Button>
        </VBox>
    </HBox>
</VBox>
