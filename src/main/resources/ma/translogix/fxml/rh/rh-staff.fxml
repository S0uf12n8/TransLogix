<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.rh.RhStaffController"
      styleClass="rh-page" spacing="20">
    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="Effectif &amp; Registre du Personnel" styleClass="rh-eyebrow"/>
            <Label text="Chauffeurs &amp; Employ&#233;s" styleClass="rh-section-title"/>
            <Label text="Annuaire complet, contrats, matricules CNSS et affectations." styleClass="rh-muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Ajouter un employ&#233;" onAction="#ajouter" styleClass="rh-btn-primary"/>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="rh-panel,rh-panel-pad" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Chauffeurs PL / SPL" styleClass="rh-kpi-label"/>
            <Label text="30" styleClass="rh-kpi-value"/>
        </VBox>
        <VBox styleClass="rh-panel,rh-panel-pad" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Personnel Administratif &amp; D&#233;p&#244;t" styleClass="rh-kpi-label"/>
            <Label text="12" styleClass="rh-kpi-value,rh-accent"/>
        </VBox>
        <VBox styleClass="rh-panel,rh-panel-pad" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Contrats CDI / CDD" styleClass="rh-kpi-label"/>
            <Label text="38 CDI / 4 CDD" styleClass="rh-kpi-value,rh-positive"/>
        </VBox>
    </HBox>

    <VBox styleClass="rh-panel">
        <HBox styleClass="rh-panel-head" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Registre du personnel" styleClass="rh-panel-title"/>
                <Label text="Recherchez un salari&#233; par nom, CIN, N&#176; CNSS ou r&#244;le." styleClass="rh-card-hint"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="recherche" promptText="Rechercher un salari&#233;..." styleClass="rh-input" prefWidth="260"/>
        </HBox>
        <TableView fx:id="table" styleClass="rh-table" prefHeight="300">
            <columns>
                <TableColumn fx:id="colNom" text="Matricule &amp; Nom" prefWidth="200"/>
                <TableColumn fx:id="colIdentite" text="CIN &amp; CNSS" prefWidth="150"/>
                <TableColumn fx:id="colPoste" text="Poste" prefWidth="170"/>
                <TableColumn fx:id="colPermis" text="Permis / Cat&#233;gorie" prefWidth="170"/>
                <TableColumn fx:id="colEmbauche" text="Embauche" prefWidth="110"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="110"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
