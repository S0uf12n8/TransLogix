<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<!-- "Nouveau Salarié" (rh.html openStaffModal, Majda's fields), shown by EmployesController. Buttons are added by RhUi. -->
<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ma.translogix.controller.rh.EmployeFormulaireController"
            stylesheets="@../../css/app.css"
            prefWidth="500" styleClass="form-dialog">
    <header>
        <VBox spacing="4" styleClass="form-dialog-header">
            <Label text="GESTION RH" styleClass="eyebrow"/>
            <Label fx:id="titre" text="Nouveau Salari&#233;" styleClass="dialog-title"/>
            <Label fx:id="description" text="Saisissez les informations administratives du nouveau collaborateur."
                   wrapText="true" styleClass="muted"/>
        </VBox>
    </header>
    <content>
        <VBox spacing="12">
            <GridPane hgap="12" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Pr&#233;nom" styleClass="form-label"/>
                    <TextField fx:id="champPrenom" promptText="Ex : Amine" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Nom" styleClass="form-label"/>
                    <TextField fx:id="champNom" promptText="Ex : El Idrissi" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="CIN" styleClass="form-label"/>
                    <TextField fx:id="champCin" promptText="Ex : BE-998822" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Num&#233;ro CNSS" styleClass="form-label"/>
                    <TextField fx:id="champCnss" promptText="Ex : 198273645" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Poste occup&#233;" styleClass="form-label"/>
                    <ComboBox fx:id="champPoste" promptText="Choisir un poste" maxWidth="Infinity" styleClass="form-combo"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="Type de contrat" styleClass="form-label"/>
                    <ComboBox fx:id="champContrat" promptText="Choisir un contrat" maxWidth="Infinity" styleClass="form-combo"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="Date d'embauche" styleClass="form-label"/>
                    <DatePicker fx:id="champEmbauche" maxWidth="Infinity" styleClass="form-combo"/>
                </VBox>
            </GridPane>
            <Label fx:id="note" text="Matricule MAT-AAAA-NN attribu&#233; automatiquement (ann&#233;e d'embauche)."
                   wrapText="true" styleClass="form-note"/>
        </VBox>
    </content>
</DialogPane>
