<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- "Recrutement & Onboarding" (rh.html recruitment): Iteration 3. Majda's kanban and sample candidates,
     shown as DÉMO; every action says "Module pas encore livré (itération 3)". No model or service yet. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.rh.RecrutementController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="PIPELINE RH &amp; INT&#201;GRATION" styleClass="eyebrow"/>
                <Label text="D&#201;MO" styleClass="chip-demo"/>
            </HBox>
            <Label text="Recrutement &amp; Onboarding" styleClass="section-heading"/>
            <Label text="Gestion des candidatures de chauffeurs et parcours d'int&#233;gration." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Publier une offre" onAction="#pasEncoreLivre" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
    </HBox>

    <HBox spacing="16" alignment="TOP_LEFT">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="CANDIDATURES RE&#199;UES" styleClass="eyebrow"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="4" styleClass="badge-gray"/>
            </HBox>
            <VBox styleClass="kanban-card" spacing="6">
                <Label text="Amine El Idrissi" styleClass="alert-title"/>
                <Label text="Permis EC &#183; 8 ans d'exp&#233;rience PL" styleClass="alert-text"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="&#9679; Entretien &#224; fixer" styleClass="badge-blue"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Inviter" onAction="#pasEncoreLivre" styleClass="link-orange"/>
                </HBox>
            </VBox>
            <VBox styleClass="kanban-card" spacing="6">
                <Label text="Othmane Naciri" styleClass="alert-title"/>
                <Label text="Permis C &#183; Transport National" styleClass="alert-text"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="&#9679; CV Re&#231;u" styleClass="badge-gray"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="&#201;tudier" onAction="#pasEncoreLivre" styleClass="link-orange"/>
                </HBox>
            </VBox>
        </VBox>

        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="EN TEST CONDUITE" styleClass="eyebrow"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="1" styleClass="badge-amber"/>
            </HBox>
            <VBox styleClass="kanban-card" spacing="6">
                <Label text="Hassan Mansouri" styleClass="alert-title"/>
                <Label text="Test pratique sur Volvo FH &#224; Casablanca" styleClass="alert-text"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="&#9679; Test en cours" styleClass="badge-amber"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Valider Test" onAction="#pasEncoreLivre" styleClass="link-orange"/>
                </HBox>
            </VBox>
        </VBox>

        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="ONBOARDING &amp; VISITE M&#201;DICALE" styleClass="eyebrow"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="1" styleClass="badge-green"/>
            </HBox>
            <VBox styleClass="kanban-card" spacing="6">
                <Label text="Tariq Kasmi" styleClass="alert-title"/>
                <Label text="Signature contrat CDI + Visite d'embauche" styleClass="alert-text"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="&#9679; Finalisation" styleClass="badge-green"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Int&#233;grer" onAction="#pasEncoreLivre" styleClass="link-orange"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
