<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.rh.RhRecruitmentController"
      styleClass="rh-page" spacing="20">
    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="Pipeline RH &amp; Int&#233;gration" styleClass="rh-eyebrow"/>
            <Label text="Recrutement &amp; Onboarding" styleClass="rh-section-title"/>
            <Label text="Gestion des candidatures de chauffeurs et parcours d'int&#233;gration." styleClass="rh-muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Publier une offre" onAction="#publierOffre" styleClass="rh-btn-primary"/>
    </HBox>

    <HBox spacing="16" alignment="TOP_LEFT">
        <VBox styleClass="rh-panel,rh-panel-pad" HBox.hgrow="ALWAYS" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="CANDIDATURES RE&#199;UES" styleClass="rh-eyebrow"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="4" styleClass="rh-chip"/>
            </HBox>
            <VBox styleClass="rh-kanban-item" spacing="6">
                <Label text="Amine El Idrissi" styleClass="rh-action-title"/>
                <Label text="Permis EC &#183; 8 ans d'exp&#233;rience PL" styleClass="rh-action-sub"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Entretien &#224; fixer" styleClass="rh-status,blue"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Inviter" onAction="#inviter" styleClass="rh-link"/>
                </HBox>
            </VBox>
            <VBox styleClass="rh-kanban-item" spacing="6">
                <Label text="Othmane Naciri" styleClass="rh-action-title"/>
                <Label text="Permis C &#183; Transport National" styleClass="rh-action-sub"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="CV Re&#231;u" styleClass="rh-status,gray"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="&#201;tudier" onAction="#etudier" styleClass="rh-link"/>
                </HBox>
            </VBox>
        </VBox>

        <VBox styleClass="rh-panel,rh-panel-pad" HBox.hgrow="ALWAYS" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="EN TEST CONDUITE" styleClass="rh-eyebrow"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="1" styleClass="rh-chip"/>
            </HBox>
            <VBox styleClass="rh-kanban-item" spacing="6">
                <Label text="Hassan Mansouri" styleClass="rh-action-title"/>
                <Label text="Test pratique sur Volvo FH &#224; Casablanca" styleClass="rh-action-sub"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Test en cours" styleClass="rh-status,amber"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Valider Test" onAction="#validerTest" styleClass="rh-link"/>
                </HBox>
            </VBox>
        </VBox>

        <VBox styleClass="rh-panel,rh-panel-pad" HBox.hgrow="ALWAYS" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="ONBOARDING &amp; VISITE M&#201;DICALE" styleClass="rh-eyebrow"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="1" styleClass="rh-chip"/>
            </HBox>
            <VBox styleClass="rh-kanban-item" spacing="6">
                <Label text="Tariq Kasmi" styleClass="rh-action-title"/>
                <Label text="Signature contrat CDI + Visite d'embauche" styleClass="rh-action-sub"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Finalisation" styleClass="rh-status,green"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Int&#233;grer" onAction="#integrer" styleClass="rh-link"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
