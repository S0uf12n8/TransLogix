<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- "Paie & Prime Trajet" (rh.html payroll): Iteration 3. Majda's layout and sample rows, shown as DÉMO;
     every action says "Module pas encore livré (itération 3)". No model or service yet. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.rh.PrimesController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="R&#201;MUN&#201;RATION &amp; PRIMES LOGISTIQUES" styleClass="eyebrow"/>
                <Label text="D&#201;MO" styleClass="chip-demo"/>
            </HBox>
            <Label text="Paie &amp; Primes de Route" styleClass="section-heading"/>
            <Label text="Calcul des indemnit&#233;s kilom&#233;triques, primes de trajet et variables du mois." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Calculer les Primes" onAction="#calculer" styleClass="btn-primary"/>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Masse Salariale Estim&#233;e" styleClass="kpi-title"/>
            <Label text="285 000 MAD" styleClass="kpi-value"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Total Primes de Route (Mois)" styleClass="kpi-title"/>
            <Label text="48 500 MAD" styleClass="kpi-value,value-orange"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Jours Travaill&#233;s Flotte" styleClass="kpi-title"/>
            <Label text="620 Journ&#233;es" styleClass="kpi-value,value-green"/>
        </VBox>
    </HBox>

    <VBox styleClass="panel">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="D&#233;compte des Primes de Trajet par Chauffeur" styleClass="panel-title"/>
                <Label text="Calcul bas&#233; sur la distance parcourue et le nombre de trajets accomplis." styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="recherche" promptText="Rechercher chauffeur..." prefWidth="240" styleClass="search-field"/>
        </HBox>
        <TableView fx:id="table" fixedCellSize="52" prefHeight="240" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucun chauffeur ne correspond &#224; la recherche." styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colChauffeur" text="CHAUFFEUR" prefWidth="170" minWidth="150" sortable="false"/>
                <TableColumn fx:id="colMissions" text="MISSIONS CE MOIS" prefWidth="125" minWidth="115" sortable="false"/>
                <TableColumn fx:id="colDistance" text="DISTANCE TOTALE" prefWidth="120" minWidth="115" sortable="false"/>
                <TableColumn fx:id="colBase" text="SALAIRE DE BASE" prefWidth="125" minWidth="115" sortable="false"/>
                <TableColumn fx:id="colPrime" text="PRIME DE ROUTE (MAD)" prefWidth="150" minWidth="140" sortable="false"/>
                <TableColumn fx:id="colNet" text="NET ESTIM&#201;" prefWidth="110" minWidth="100" sortable="false"/>
                <TableColumn fx:id="colAction" text="ACTION" prefWidth="90" minWidth="80" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
