<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Client directory (issue [C2]); not in contable.html, so styled like the invoice register.
     Real data from ClientService (in-memory DAO). Create / edit in comptable/client-dialog.fxml. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.comptable.ClientsController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="PORTEFEUILLE CLIENTS" styleClass="eyebrow"/>
            <Label text="Clients" styleClass="section-heading"/>
            <Label text="Coordonn&#233;es, ICE et conditions de r&#232;glement des clients factur&#233;s." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonNouveau" text="Nouveau client" onAction="#nouveau" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
    </HBox>

    <VBox styleClass="panel">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="R&#233;pertoire des clients" styleClass="panel-title"/>
                <Label text="Recherchez par nom, ICE, t&#233;l&#233;phone ou ville." styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="recherche" promptText="Rechercher un client..." prefWidth="280" styleClass="search-field"/>
        </HBox>
        <TableView fx:id="table" fixedCellSize="52" prefHeight="440" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucun client ne correspond &#224; la recherche." styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colNom" text="CLIENT" prefWidth="180" minWidth="150"/>
                <TableColumn fx:id="colIce" text="ICE" prefWidth="130" minWidth="125"/>
                <TableColumn fx:id="colTelephone" text="T&#201;L&#201;PHONE" prefWidth="120" minWidth="105"/>
                <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="140" minWidth="90"/>
                <TableColumn fx:id="colAdresse" text="ADRESSE" prefWidth="200" minWidth="120"/>
                <TableColumn fx:id="colDelai" text="D&#201;LAI" prefWidth="100" minWidth="100"/>
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="165" minWidth="165" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
