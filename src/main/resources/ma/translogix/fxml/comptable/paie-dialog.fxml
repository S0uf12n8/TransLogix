<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ma.translogix.controller.comptable.PaieFormulaireController"
            stylesheets="@../../css/app.css" prefWidth="500" styleClass="form-dialog">
    <header>
        <VBox spacing="4" styleClass="form-dialog-header">
            <Label text="PAIEMENT DES EMPLOYÉS" styleClass="eyebrow"/>
            <Label fx:id="titre" text="Créer une fiche de paie" styleClass="dialog-title"/>
            <Label text="Saisissez le salaire et les ajustements réels. Le net est calculé automatiquement."
                   wrapText="true" styleClass="muted"/>
        </VBox>
    </header>
    <content>
        <VBox spacing="12">
            <VBox spacing="6">
                <Label text="Employé" styleClass="form-label"/>
                <ComboBox fx:id="champEmploye" promptText="Choisir un employé actif" maxWidth="Infinity"
                          styleClass="form-combo"/>
            </VBox>
            <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Mois de la paie" styleClass="form-label"/>
                    <ComboBox fx:id="champPeriode" maxWidth="Infinity" styleClass="form-combo"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Salaire de base (MAD)" styleClass="form-label"/>
                    <TextField fx:id="champSalaireBase" promptText="Ex : 8000" styleClass="search-field"/>
                </VBox>
            </HBox>
            <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Primes (MAD)" styleClass="form-label"/>
                    <TextField fx:id="champPrimes" promptText="0 si aucune" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Retenues (MAD)" styleClass="form-label"/>
                    <TextField fx:id="champRetenues" promptText="0 si aucune" styleClass="search-field"/>
                </VBox>
            </HBox>
            <HBox styleClass="apercu-tva" alignment="CENTER_LEFT" spacing="8">
                <Label text="Net calculé" styleClass="apercu-total"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="apercuNet" text="—" styleClass="apercu-total"/>
            </HBox>
            <Label text="Une seule fiche est autorisée par employé et par mois. La validation et le paiement se font depuis la liste."
                   wrapText="true" styleClass="form-note"/>
        </VBox>
    </content>
</DialogPane>
