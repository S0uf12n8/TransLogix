<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<!-- Comptable dashboard (contable.html #tab-compta-dashboard). Content only: the shell provides sidebar + top bar.
     KPI 1-3 and "Dernières factures émises" are computed from FactureService; "Reçus gazole" is static (DÉMO). -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.comptable.DashboardController"
      stylesheets="@../../css/app.css"
      spacing="24" styleClass="page">

    <!-- Header -->
    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="APER&#199;U EX&#201;CUTIF FINANCE" styleClass="eyebrow"/>
            <Label fx:id="salutation" text="Bonjour" styleClass="section-heading"/>
            <Label text="Voici l'&#233;tat des encaissements, factures et d&#233;penses de transport." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonCreer" text="Cr&#233;er une facture" onAction="#creerFacture" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
    </HBox>

    <!-- KPI cards -->
    <GridPane hgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <StackPane fx:id="kpiChiffre" styleClass="kpi-card" GridPane.columnIndex="0">
            <Circle radius="45" styleClass="kpi-decor-orange" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="14">
                <HBox>
                    <VBox spacing="10">
                        <Label text="Chiffre d'affaires mensuel" styleClass="kpi-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="5">
                            <Label fx:id="valeurChiffre" text="0" styleClass="kpi-value"/>
                            <Label text="MAD HT" styleClass="kpi-unit"/>
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="icon-orange"><SVGPath content="M12 2a10 10 0 1 1 0 20a10 10 0 1 1 0-20z M12 6a6 6 0 1 0 0 12a6 6 0 1 0 0-12z M11 8h2v8h-2z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
                </HBox>
                <Label fx:id="piedChiffre" styleClass="foot-muted"/>
            </VBox>
        </StackPane>

        <StackPane fx:id="kpiEncaissements" styleClass="kpi-card" GridPane.columnIndex="1">
            <Circle radius="45" styleClass="kpi-decor-green" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="14">
                <HBox>
                    <VBox spacing="10">
                        <Label text="Encaissements du mois" styleClass="kpi-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="5">
                            <Label fx:id="valeurEncaissements" text="0" styleClass="kpi-value"/>
                            <Label text="MAD" styleClass="kpi-unit"/>
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="icon-green"><SVGPath content="M2 7a3 3 0 0 1 3-3h14v3z M2 8h20v12H5a3 3 0 0 1-3-3z M16 12v4h4v-4z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
                </HBox>
                <Label fx:id="piedEncaissements" styleClass="foot-green"/>
            </VBox>
        </StackPane>

        <StackPane fx:id="kpiCreances" styleClass="kpi-card" GridPane.columnIndex="2">
            <Circle radius="45" styleClass="kpi-decor-red" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="14">
                <HBox>
                    <VBox spacing="10">
                        <Label text="Cr&#233;ances en retard" styleClass="kpi-title"/>
                        <HBox alignment="BASELINE_LEFT" spacing="5">
                            <Label fx:id="valeurCreances" text="0" styleClass="kpi-value"/>
                            <Label text="MAD" styleClass="kpi-unit"/>
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="icon-red"><SVGPath content="M5 2h10l5 5v15H5z M8 10h9v2H8z M8 14h9v2H8z M8 18h6v1.5H8z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
                </HBox>
                <Label fx:id="piedCreances" styleClass="foot-red"/>
            </VBox>
        </StackPane>

        <StackPane fx:id="kpiRecus" styleClass="kpi-card" GridPane.columnIndex="3">
            <Circle radius="45" styleClass="kpi-decor-sky" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="14">
                <HBox>
                    <VBox spacing="10">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Re&#231;us gazole" styleClass="kpi-title"/>
                            <Label text="D&#201;MO" styleClass="chip-demo" minWidth="-Infinity"/>
                        </HBox>
                        <HBox alignment="BASELINE_LEFT" spacing="5">
                            <Label text="4 850" styleClass="kpi-value"/>
                            <Label text="MAD" styleClass="kpi-unit"/>
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="icon-sky"><SVGPath content="M4 2h16v20l-2.7-1.8L14.7 22L12 20.2L9.3 22l-2.6-1.8L4 22z M7 7h10v2H7z M7 11h10v2H7z M7 15h6v2H7z" fillRule="EVEN_ODD" styleClass="svg"/></StackPane>
                </HBox>
                <Label text="&#9679; 3 re&#231;us &#224; valider" styleClass="foot-amber"/>
            </VBox>
        </StackPane>
    </GridPane>

    <!-- Latest invoices + quick actions -->
    <GridPane hgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="67"/>
            <ColumnConstraints percentWidth="33"/>
        </columnConstraints>

        <VBox styleClass="panel" GridPane.columnIndex="0">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Derni&#232;res factures &#233;mises" styleClass="panel-title"/>
                    <Label text="Suivi des r&#232;glements clients r&#233;cents" styleClass="panel-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Voir toutes les factures   &#8594;" onAction="#voirFactures" styleClass="btn-secondary" minWidth="-Infinity"/>
            </HBox>
            <TableView fx:id="tableFactures" fixedCellSize="52" prefHeight="300" styleClass="flat-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Aucune facture &#233;mise." styleClass="empty-placeholder"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colNumero" text="N&#176; FACTURE" prefWidth="122" minWidth="122" sortable="false"/>
                    <TableColumn fx:id="colClient" text="CLIENT" prefWidth="150" minWidth="100" sortable="false"/>
                    <TableColumn fx:id="colEmission" text="&#201;MISSION" prefWidth="92" minWidth="92" sortable="false"/>
                    <TableColumn fx:id="colTtc" text="MONTANT TTC" prefWidth="128" minWidth="128" sortable="false"/>
                    <TableColumn fx:id="colStatut" text="STATUT" prefWidth="108" minWidth="108" sortable="false"/>
                    <TableColumn fx:id="colAction" text="ACTION" prefWidth="80" minWidth="80" sortable="false"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="panel-padded" spacing="14" GridPane.columnIndex="1">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox spacing="3">
                    <Label text="Actions financi&#232;res rapides" styleClass="panel-title"/>
                    <Label text="Raccourcis du jour" styleClass="panel-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Urgent" styleClass="chip-orange" minWidth="-Infinity"/>
            </HBox>
            <VBox fx:id="listeActions" spacing="12"/>
        </VBox>
    </GridPane>

    <!-- Financial charts: both fed by FactureService with the same invoices as the KPI cards. -->
    <GridPane hgap="20" vgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="67"/>
            <ColumnConstraints percentWidth="33"/>
        </columnConstraints>

        <VBox styleClass="panel" GridPane.columnIndex="0">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Chiffre d'affaires mensuel" styleClass="panel-title"/>
                    <Label fx:id="sousTitreCa" text="6 derniers mois, en MAD HT" styleClass="panel-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="periodeCa" prefWidth="150"/>
                <Label fx:id="totalCa" styleClass="chart-total" minWidth="-Infinity"/>
            </HBox>
            <BarChart fx:id="graphiqueCa" styleClass="dashboard-chart" prefHeight="280" legendVisible="false"
                      animated="false">
                <xAxis>
                    <CategoryAxis label="Mois"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="axeCa" label="MAD HT"/>
                </yAxis>
            </BarChart>
        </VBox>

        <VBox styleClass="panel" GridPane.columnIndex="1">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Factures par statut" styleClass="panel-title"/>
                    <Label fx:id="sousTitreStatuts" text="Répartition du portefeuille" styleClass="panel-sub"/>
                </VBox>
            </HBox>
            <PieChart fx:id="graphiqueStatuts" styleClass="dashboard-chart" prefHeight="280" animated="false"/>
        </VBox>
    </GridPane>
</VBox>
