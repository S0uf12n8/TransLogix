<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Saisie d'une dépense réelle, rattachée à une mission existante. Les chiffres sont ceux du reçu. -->
<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ma.translogix.controller.comptable.DepenseFormulaireController"
            stylesheets="@../../css/app.css"
            prefWidth="520" styleClass="form-dialog">
    <header>
        <VBox spacing="4" styleClass="form-dialog-header">
            <Label text="COMPTABILIT&#201; &amp; FINANCE" styleClass="eyebrow"/>
            <Label fx:id="titre" text="Saisir une dépense" styleClass="dialog-title"/>
            <Label text="Rattachez le reçu à une mission réelle et à son chauffeur." wrapText="true" styleClass="muted"/>
        </VBox>
    </header>
    <content>
        <VBox spacing="12">
            <VBox spacing="6">
                <Label text="Mission" styleClass="form-label"/>
                <ComboBox fx:id="champMission" promptText="Choisir une mission" maxWidth="Infinity"
                          styleClass="form-combo"/>
                <Label fx:id="apercuMission" text="Sélectionnez une mission réelle." styleClass="form-note"/>
            </VBox>
            <HBox spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Chauffeur" styleClass="form-label"/>
                    <ComboBox fx:id="champChauffeur" promptText="Choisir un chauffeur" maxWidth="Infinity"
                              styleClass="form-combo"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Type de dépense" styleClass="form-label"/>
                    <ComboBox fx:id="champType" promptText="Choisir un type" maxWidth="Infinity"
                              styleClass="form-combo"/>
                </VBox>
            </HBox>
            <VBox spacing="6">
                <Label text="Station / lieu" styleClass="form-label"/>
                <TextField fx:id="champStation" promptText="Ex : Station ZZ Casablanca" styleClass="search-field"/>
            </VBox>
            <HBox spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Montant TTC (MAD)" styleClass="form-label"/>
                    <TextField fx:id="champMontant" promptText="Ex : 850,50" styleClass="search-field"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Litres (carburant uniquement)" styleClass="form-label"/>
                    <TextField fx:id="champLitres" promptText="Ex : 62,40" styleClass="search-field"/>
                </VBox>
            </HBox>
            <VBox spacing="6">
                <Label text="Date du reçu" styleClass="form-label"/>
                <DatePicker fx:id="champDate" promptText="JJ/MM/AAAA" maxWidth="Infinity"/>
            </VBox>
            <Label text="La dépense est enregistrée « En attente ». Elle pourra ensuite être validée ou refusée."
                   wrapText="true" styleClass="form-note"/>
        </VBox>
    </content>
</DialogPane>
