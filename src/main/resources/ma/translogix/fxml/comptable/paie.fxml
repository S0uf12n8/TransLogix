<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<!-- Paiement des employés: real employees, salaries entered by the accountant, net computed by PaieService. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.comptable.PaieController"
      stylesheets="@../../css/app.css" spacing="18" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="10">
        <VBox spacing="6">
            <Label text="RÉMUNÉRATION DU PERSONNEL" styleClass="eyebrow"/>
            <Label text="Paiement des employés" styleClass="section-heading"/>
            <Label text="Fiches de paie réelles : le net est calculé, aucun salaire n'est inventé."
                   styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonCreer" text="Créer une fiche" onAction="#creer" styleClass="btn-primary" minWidth="-Infinity">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
        <Button fx:id="boutonValider" text="Valider" onAction="#valider" styleClass="btn-secondary" minWidth="-Infinity"/>
        <Button fx:id="boutonPayer" text="Enregistrer le paiement" onAction="#payer" styleClass="btn-secondary" minWidth="-Infinity"/>
        <Button text="Détails" onAction="#afficherDetails" styleClass="btn-secondary" minWidth="-Infinity"/>
    </HBox>

    <GridPane hgap="14">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <StackPane styleClass="kpi-card" GridPane.columnIndex="0">
            <Circle radius="45" styleClass="kpi-decor-sky" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="12">
                <Label text="Net total affiché" styleClass="kpi-title"/>
                <HBox alignment="BASELINE_LEFT" spacing="5">
                    <Label fx:id="valeurNet" text="0" styleClass="kpi-value"/>
                    <Label text="MAD" styleClass="kpi-unit"/>
                </HBox>
                <Label fx:id="piedNet" styleClass="foot-muted"/>
            </VBox>
        </StackPane>

        <StackPane styleClass="kpi-card" GridPane.columnIndex="1">
            <Circle radius="45" styleClass="kpi-decor-green" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="12">
                <Label text="Salaires réglés" styleClass="kpi-title"/>
                <HBox alignment="BASELINE_LEFT" spacing="5">
                    <Label fx:id="valeurPaye" text="0" styleClass="kpi-value"/>
                    <Label text="MAD" styleClass="kpi-unit"/>
                </HBox>
                <Label fx:id="piedPaye" styleClass="foot-green"/>
            </VBox>
        </StackPane>

        <StackPane styleClass="kpi-card" GridPane.columnIndex="2">
            <Circle radius="45" styleClass="kpi-decor-orange" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="12">
                <Label text="Reste à régler" styleClass="kpi-title"/>
                <HBox alignment="BASELINE_LEFT" spacing="5">
                    <Label fx:id="valeurImpaye" text="0" styleClass="kpi-value"/>
                    <Label text="MAD" styleClass="kpi-unit"/>
                </HBox>
                <Label fx:id="piedImpaye" styleClass="foot-amber"/>
            </VBox>
        </StackPane>

        <StackPane styleClass="kpi-card" GridPane.columnIndex="3">
            <Circle radius="45" styleClass="kpi-decor-sky" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="12">
                <Label text="Employés concernés" styleClass="kpi-title"/>
                <Label fx:id="valeurEmployes" text="0" styleClass="kpi-value"/>
                <Label fx:id="piedEmployes" styleClass="foot-blue"/>
            </VBox>
        </StackPane>
    </GridPane>

    <VBox styleClass="panel" spacing="12">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Recherche et filtres" styleClass="panel-title"/>
                <Label text="Une seule fiche par employé et par mois ; le numéro est attribué automatiquement."
                       styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Réinitialiser" onAction="#reinitialiser" styleClass="btn-secondary" minWidth="-Infinity"/>
            <Button text="Actualiser" onAction="#rafraichir" styleClass="btn-secondary" minWidth="-Infinity"/>
        </HBox>
        <TextField fx:id="recherche" promptText="Rechercher un numéro, un employé, un matricule..."
                   styleClass="search-field"/>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label text="MOIS" styleClass="muted"/>
                <ComboBox fx:id="filtrePeriode" prefWidth="150" promptText="Tous les mois"/>
            </VBox>
            <VBox spacing="4">
                <Label text="STATUT" styleClass="muted"/>
                <ComboBox fx:id="filtreStatut" prefWidth="160" promptText="Tous les statuts"/>
            </VBox>
            <VBox spacing="4">
                <Label text="EMPLOYÉ" styleClass="muted"/>
                <ComboBox fx:id="filtreEmploye" prefWidth="220" promptText="Tous les employés"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- First table of the page: the top-bar Imprimer action prints these payroll records. -->
    <VBox styleClass="panel" VBox.vgrow="ALWAYS" spacing="12">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Fiches de paie" styleClass="panel-title"/>
                <Label fx:id="resumeTable" text="0 fiche · 0,00 MAD net" styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Clic droit : détail, validation, paiement" styleClass="muted"/>
        </HBox>
        <TableView fx:id="table" fixedCellSize="52" prefHeight="360" VBox.vgrow="ALWAYS" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucune fiche de paie. Créez une fiche pour un employé existant."
                       styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colNumero" text="N° FICHE" prefWidth="140" minWidth="125"/>
                <TableColumn fx:id="colEmploye" text="EMPLOYÉ" prefWidth="175" minWidth="145"/>
                <TableColumn fx:id="colPeriode" text="MOIS" prefWidth="90" minWidth="85"/>
                <TableColumn fx:id="colBase" text="BASE" prefWidth="125" minWidth="110"/>
                <TableColumn fx:id="colPrimes" text="PRIMES" prefWidth="115" minWidth="100"/>
                <TableColumn fx:id="colRetenues" text="RETENUES" prefWidth="120" minWidth="105"/>
                <TableColumn fx:id="colNet" text="NET" prefWidth="130" minWidth="115"/>
                <TableColumn fx:id="colStatut" text="STATUT" prefWidth="115" minWidth="105"/>
                <TableColumn fx:id="colPaiement" text="DATE PAIEMENT" prefWidth="140" minWidth="125"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
