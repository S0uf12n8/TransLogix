<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.comptable.JournalController"
      stylesheets="@../../css/app.css"
      spacing="20"
      styleClass="page">

    <!-- Page heading -->
    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="TRAÇABILITÉ ET CONTRÔLE" styleClass="eyebrow"/>
            <Label text="Journal comptable" styleClass="section-heading"/>
            <Label text="Traçabilité des opérations réellement enregistrées dans TransLogix."
                   styleClass="muted"/>
        </VBox>
    </HBox>

    <!-- Statistics -->
    <GridPane hgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="33.33"/>
            <ColumnConstraints percentWidth="33.33"/>
            <ColumnConstraints percentWidth="33.34"/>
        </columnConstraints>

        <StackPane fx:id="kpiTotal"
                   styleClass="kpi-card"
                   GridPane.columnIndex="0">
            <Circle radius="45"
                    styleClass="kpi-decor-sky"
                    StackPane.alignment="TOP_RIGHT"
                    translateX="40"
                    translateY="-44"/>
            <VBox spacing="14">
                <HBox>
                    <VBox spacing="10">
                        <Label text="Total des opérations" styleClass="kpi-title"/>
                        <Label fx:id="valeurTotal"
                               text="0"
                               styleClass="kpi-value"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label text="Selon les filtres appliqués" styleClass="foot-blue"/>
            </VBox>
        </StackPane>

        <StackPane fx:id="kpiReussis"
                   styleClass="kpi-card"
                   GridPane.columnIndex="1">
            <Circle radius="45"
                    styleClass="kpi-decor-green"
                    StackPane.alignment="TOP_RIGHT"
                    translateX="40"
                    translateY="-44"/>
            <VBox spacing="14">
                <HBox>
                    <VBox spacing="10">
                        <Label text="Opérations réussies" styleClass="kpi-title"/>
                        <Label fx:id="valeurReussis"
                               text="0"
                               styleClass="kpi-value"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label text="Actions terminées avec succès" styleClass="foot-green"/>
            </VBox>
        </StackPane>

        <StackPane fx:id="kpiRefuses"
                   styleClass="kpi-card"
                   GridPane.columnIndex="2">
            <Circle radius="45"
                    styleClass="kpi-decor-red"
                    StackPane.alignment="TOP_RIGHT"
                    translateX="40"
                    translateY="-44"/>
            <VBox spacing="14">
                <HBox>
                    <VBox spacing="10">
                        <Label text="Opérations refusées" styleClass="kpi-title"/>
                        <Label fx:id="valeurRefuses"
                               text="0"
                               styleClass="kpi-value"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label text="Actions refusées ou échouées" styleClass="foot-red"/>
            </VBox>
        </StackPane>
    </GridPane>

    <!-- Filters -->
    <VBox styleClass="panel" spacing="14">
        <VBox spacing="3">
            <Label text="Filtres de recherche" styleClass="panel-title"/>
            <Label text="Affinez l'historique par utilisateur, module, résultat ou période."
                   styleClass="panel-sub"/>
        </VBox>

        <TextField fx:id="recherche"
                   promptText="Rechercher un utilisateur, une action, un module..."
                   styleClass="search-field"/>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="5">
                <Label text="MODULE" styleClass="muted"/>
                <ComboBox fx:id="filtreModule" prefWidth="190"/>
            </VBox>

            <VBox spacing="5">
                <Label text="RÉSULTAT" styleClass="muted"/>
                <ComboBox fx:id="filtreResultat" prefWidth="160"/>
            </VBox>

            <VBox spacing="5">
                <Label text="DU" styleClass="muted"/>
                <DatePicker fx:id="dateDu" prefWidth="150"
                            promptText="Date de début"/>
            </VBox>

            <VBox spacing="5">
                <Label text="AU" styleClass="muted"/>
                <DatePicker fx:id="dateAu" prefWidth="150"
                            promptText="Date de fin"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Réinitialiser"
                    onAction="#reinitialiser"
                    styleClass="btn-secondary"
                    minWidth="-Infinity"/>
        </HBox>
    </VBox>

    <!-- Events table -->
    <VBox styleClass="panel"
          spacing="12"
          VBox.vgrow="ALWAYS">

        <HBox styleClass="panel-header"
              alignment="CENTER_LEFT"
              spacing="12">
            <VBox spacing="3">
                <Label text="Historique des opérations" styleClass="panel-title"/>
                <Label fx:id="sousTitre"
                       text="Toutes les opérations enregistrées"
                       styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Actualiser"
                    onAction="#actualiser"
                    styleClass="btn-secondary"/>
        </HBox>

        <TableView fx:id="table"
                   fixedCellSize="52"
                   prefHeight="420"
                   VBox.vgrow="ALWAYS"
                   styleClass="flat-table">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>

            <placeholder>
                <Label text="Aucune opération trouvée."
                       styleClass="empty-placeholder"/>
            </placeholder>

            <columns>
                <TableColumn fx:id="colDate"
                             text="DATE ET HEURE"
                             prefWidth="165"
                             minWidth="145"/>

                <TableColumn fx:id="colUtilisateur"
                             text="UTILISATEUR"
                             prefWidth="150"
                             minWidth="120"/>

                <TableColumn fx:id="colModule"
                             text="MODULE"
                             prefWidth="130"
                             minWidth="110"/>

                <TableColumn fx:id="colAction"
                             text="ACTION"
                             prefWidth="300"
                             minWidth="180"/>

                <TableColumn fx:id="colResultat"
                             text="RÉSULTAT"
                             prefWidth="120"
                             minWidth="100"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
