<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<!-- Trésorerie & bilan: real invoices, payments and clients. No invented "solde" or demo amounts. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.comptable.TresorerieController"
      stylesheets="@../../css/app.css" spacing="18" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="ANALYSE FINANCIÈRE" styleClass="eyebrow"/>
            <Label text="Trésorerie &amp; bilan" styleClass="section-heading"/>
            <Label text="Facturation et encaissements réels : deux flux distincts, jamais additionnés."
                   styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Voir les factures" onAction="#voirFactures" styleClass="btn-secondary" minWidth="-Infinity"/>
        <Button text="Bilan complet" onAction="#afficherBilan" styleClass="btn-secondary" minWidth="-Infinity"/>
    </HBox>

    <!-- KPI row -->
    <GridPane hgap="14">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <StackPane styleClass="kpi-card" GridPane.columnIndex="0">
            <Circle radius="45" styleClass="kpi-decor-orange" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="12">
                <Label text="Facturé TTC" styleClass="kpi-title"/>
                <HBox alignment="BASELINE_LEFT" spacing="5">
                    <Label fx:id="valeurFacture" text="0" styleClass="kpi-value"/>
                    <Label text="MAD" styleClass="kpi-unit"/>
                </HBox>
                <Label fx:id="piedFacture" styleClass="foot-muted"/>
            </VBox>
        </StackPane>

        <StackPane styleClass="kpi-card" GridPane.columnIndex="1">
            <Circle radius="45" styleClass="kpi-decor-green" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="12">
                <Label text="Encaissé" styleClass="kpi-title"/>
                <HBox alignment="BASELINE_LEFT" spacing="5">
                    <Label fx:id="valeurEncaisse" text="0" styleClass="kpi-value"/>
                    <Label text="MAD" styleClass="kpi-unit"/>
                </HBox>
                <Label fx:id="piedEncaisse" styleClass="foot-green"/>
            </VBox>
        </StackPane>

        <StackPane styleClass="kpi-card" GridPane.columnIndex="2">
            <Circle radius="45" styleClass="kpi-decor-red" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="12">
                <Label text="Créances TTC" styleClass="kpi-title"/>
                <HBox alignment="BASELINE_LEFT" spacing="5">
                    <Label fx:id="valeurCreances" text="0" styleClass="kpi-value"/>
                    <Label text="MAD" styleClass="kpi-unit"/>
                </HBox>
                <Label fx:id="piedCreances" styleClass="foot-red"/>
            </VBox>
        </StackPane>

        <StackPane styleClass="kpi-card" GridPane.columnIndex="3">
            <Circle radius="45" styleClass="kpi-decor-sky" StackPane.alignment="TOP_RIGHT" translateX="40" translateY="-44"/>
            <VBox spacing="12">
                <Label text="Taux d'encaissement" styleClass="kpi-title"/>
                <Label fx:id="valeurTaux" text="0 %" styleClass="kpi-value"/>
                <Label fx:id="piedTaux" styleClass="foot-blue"/>
            </VBox>
        </StackPane>
    </GridPane>

    <!-- Period and filters -->
    <VBox styleClass="panel" spacing="12">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Période et critères" styleClass="panel-title"/>
                <Label fx:id="resumePeriode" text="Toutes les périodes" styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Réinitialiser" onAction="#reinitialiser" styleClass="btn-secondary" minWidth="-Infinity"/>
            <Button text="Actualiser" onAction="#rafraichir" styleClass="btn-secondary" minWidth="-Infinity"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label text="ÉMISSION / ENCAISSEMENT DU" styleClass="muted"/>
                <DatePicker fx:id="dateDu" prefWidth="165" promptText="Date de début"/>
            </VBox>
            <VBox spacing="4">
                <Label text="AU" styleClass="muted"/>
                <DatePicker fx:id="dateAu" prefWidth="165" promptText="Date de fin"/>
            </VBox>
            <VBox spacing="4">
                <Label text="CLIENT" styleClass="muted"/>
                <ComboBox fx:id="filtreClient" prefWidth="210" promptText="Tous les clients"/>
            </VBox>
            <VBox spacing="4">
                <Label text="MODE DE RÈGLEMENT" styleClass="muted"/>
                <ComboBox fx:id="filtreMode" prefWidth="180" promptText="Tous les modes"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Chart + status summary -->
    <GridPane hgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="67"/>
            <ColumnConstraints percentWidth="33"/>
        </columnConstraints>

        <VBox styleClass="panel" GridPane.columnIndex="0">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Facturation et trésorerie par mois" styleClass="panel-title"/>
                    <Label fx:id="resumeFacturation" text="HT · TVA · TTC" styleClass="panel-sub"/>
                </VBox>
            </HBox>
            <BarChart fx:id="graphiqueTresorerie" styleClass="comptable-tresorerie-bar" prefHeight="250"
                      legendVisible="true" animated="false">
                <xAxis>
                    <CategoryAxis fx:id="axeMois" label="Mois"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="axeMontants" label="MAD"/>
                </yAxis>
            </BarChart>
        </VBox>

        <VBox styleClass="panel-padded" spacing="10" GridPane.columnIndex="1">
            <VBox spacing="3">
                <Label text="Répartition par statut" styleClass="panel-title"/>
                <Label text="Montants TTC · factures émises sur la période" styleClass="panel-sub"/>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="●" styleClass="badge-green"/>
                <Label text="Payée" styleClass="muted" minWidth="80"/>
                <Label fx:id="statutPayee" text="0 · 0,00 MAD" styleClass="cell-strong"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="●" styleClass="badge-blue"/>
                <Label text="En attente" styleClass="muted" minWidth="80"/>
                <Label fx:id="statutAttente" text="0 · 0,00 MAD" styleClass="cell-strong"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="●" styleClass="badge-red"/>
                <Label text="En retard" styleClass="muted" minWidth="80"/>
                <Label fx:id="statutRetard" text="0 · 0,00 MAD" styleClass="cell-strong"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="●" styleClass="badge-gray"/>
                <Label text="Annulée" styleClass="muted" minWidth="80"/>
                <Label fx:id="statutAnnulee" text="0 · 0,00 MAD" styleClass="cell-strong"/>
            </HBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Bilan complet : non disponible (dépenses et paie non consolidées)."
                   styleClass="comptable-tresorerie-indisponible" wrapText="true"/>
        </VBox>
    </GridPane>

    <!-- Payment history: the first table of the page, used by the top-bar Imprimer action. -->
    <VBox styleClass="panel" VBox.vgrow="ALWAYS" spacing="12">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Historique des encaissements" styleClass="panel-title"/>
                <Label text="Un règlement = une facture réglée. Clic droit pour ouvrir le client."
                       styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="recherche" promptText="Rechercher une facture, un client, une référence..."
                       prefWidth="320" styleClass="search-field"/>
        </HBox>
        <TableView fx:id="table" fixedCellSize="52" prefHeight="300" VBox.vgrow="ALWAYS" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucun encaissement pour ces critères." styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colDate" text="DATE" prefWidth="120" minWidth="105"/>
                <TableColumn fx:id="colFacture" text="N° FACTURE" prefWidth="145" minWidth="120"/>
                <TableColumn fx:id="colClient" text="CLIENT" prefWidth="190" minWidth="150"/>
                <TableColumn fx:id="colMode" text="MODE" prefWidth="150" minWidth="130"/>
                <TableColumn fx:id="colReference" text="RÉFÉRENCE" prefWidth="160" minWidth="130"/>
                <TableColumn fx:id="colMontant" text="MONTANT ENCAISSÉ" prefWidth="170" minWidth="150"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
