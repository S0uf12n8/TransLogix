<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- "Créer une facture transport" (contable.html openInvoiceModal). Buttons are added by ComptableUi. -->
<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ma.translogix.controller.comptable.FactureFormulaireController"
            stylesheets="@../../css/app.css"
            prefWidth="480" styleClass="form-dialog">
    <header>
        <VBox spacing="4" styleClass="form-dialog-header">
            <Label text="COMPTABILIT&#201; &amp; FINANCE" styleClass="eyebrow"/>
            <Label fx:id="titre" text="Cr&#233;er une facture transport" styleClass="dialog-title"/>
            <Label text="&#201;mettez une nouvelle facture client avec TVA (14 %)." wrapText="true" styleClass="muted"/>
        </VBox>
    </header>
    <content>
        <VBox spacing="12">
            <VBox spacing="6">
                <Label text="Client" styleClass="form-label"/>
                <ComboBox fx:id="champClient" promptText="Choisir un client" maxWidth="Infinity" styleClass="form-combo"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Montant hors taxe (HT en MAD)" styleClass="form-label"/>
                <TextField fx:id="champMontant" promptText="Ex : 20000" styleClass="search-field"/>
            </VBox>
            <VBox spacing="6">
                <Label text="R&#233;f&#233;rence trajet / ordre" styleClass="form-label"/>
                <TextField fx:id="champReference" promptText="Ex : TRJ-9081" styleClass="search-field"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Conditions de r&#232;glement" styleClass="form-label"/>
                <ComboBox fx:id="champConditions" maxWidth="Infinity" styleClass="form-combo"/>
            </VBox>
            <VBox spacing="6" styleClass="apercu-tva">
                <HBox>
                    <Label text="TVA (14 %)" styleClass="apercu-libelle"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="apercuTva" text="&#8212;" styleClass="apercu-libelle"/>
                </HBox>
                <HBox>
                    <Label text="Total TTC" styleClass="apercu-total"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="apercuTtc" text="&#8212;" styleClass="apercu-total"/>
                </HBox>
                <HBox>
                    <Label text="&#201;ch&#233;ance" styleClass="apercu-libelle"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="apercuEcheance" text="&#8212;" styleClass="apercu-libelle"/>
                </HBox>
            </VBox>
            <Label text="Num&#233;ro FACT-AAAA-NNN attribu&#233; automatiquement." styleClass="form-note"/>
        </VBox>
    </content>
</DialogPane>
