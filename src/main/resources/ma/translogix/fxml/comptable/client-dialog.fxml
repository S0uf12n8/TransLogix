<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<!-- Client form, shown in a dialog by ClientsController. Buttons are added by ComptableUi. -->
<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ma.translogix.controller.comptable.ClientFormulaireController"
            stylesheets="@../../css/app.css"
            prefWidth="500" styleClass="form-dialog">
    <header>
        <VBox spacing="4" styleClass="form-dialog-header">
            <Label text="PORTEFEUILLE CLIENTS" styleClass="eyebrow"/>
            <Label fx:id="titre" text="Nouveau client" styleClass="dialog-title"/>
            <Label fx:id="description" text="Saisissez les informations du client." wrapText="true" styleClass="muted"/>
        </VBox>
    </header>
    <content>
        <VBox spacing="12">
            <VBox spacing="6">
                <Label text="Raison sociale" styleClass="form-label"/>
                <TextField fx:id="champNom" promptText="Ex : LogiMaroc SARL" styleClass="search-field"/>
            </VBox>
            <GridPane hgap="12" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <VBox spacing="6" GridPane.columnIndex="0">
                    <Label text="ICE (facultatif)" styleClass="form-label"/>
                    <TextField fx:id="champIce" promptText="15 chiffres" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1">
                    <Label text="T&#233;l&#233;phone" styleClass="form-label"/>
                    <TextField fx:id="champTelephone" promptText="Ex : 0522 45 18 90" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Email (facultatif)" styleClass="form-label"/>
                    <TextField fx:id="champEmail" promptText="Ex : compta@client.ma" styleClass="search-field"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="D&#233;lai de paiement (jours)" styleClass="form-label"/>
                    <TextField fx:id="champDelai" promptText="30" styleClass="search-field"/>
                </VBox>
            </GridPane>
            <VBox spacing="6">
                <Label text="Adresse" styleClass="form-label"/>
                <TextField fx:id="champAdresse" promptText="Ex : Zone industrielle Ain Sebaa, Casablanca" styleClass="search-field"/>
            </VBox>
            <Label text="Le d&#233;lai de paiement est pr&#233;-s&#233;lectionn&#233; &#224; la cr&#233;ation d'une facture (0 = comptant)." wrapText="true" styleClass="form-note"/>
        </VBox>
    </content>
</DialogPane>
