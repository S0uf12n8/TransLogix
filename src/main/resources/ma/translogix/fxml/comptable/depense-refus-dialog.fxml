<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<!-- Motif obligatoire du refus d'une dépense (conservé dans l'historique et l'audit). -->
<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ma.translogix.controller.comptable.DepenseRefusController"
            stylesheets="@../../css/app.css"
            prefWidth="460" styleClass="form-dialog">
    <header>
        <VBox spacing="4" styleClass="form-dialog-header">
            <Label text="COMPTABILIT&#201; &amp; FINANCE" styleClass="eyebrow"/>
            <Label fx:id="titre" text="Refuser la dépense" styleClass="dialog-title"/>
            <Label text="Le motif est obligatoire et restera visible dans l'historique." wrapText="true"
                   styleClass="muted"/>
        </VBox>
    </header>
    <content>
        <VBox spacing="12">
            <Label fx:id="resume" text="" styleClass="form-note"/>
            <VBox spacing="6">
                <Label text="Motif du refus" styleClass="form-label"/>
                <TextArea fx:id="champMotif" promptText="Ex : Justificatif illisible" prefRowCount="4"
                          wrapText="true"/>
            </VBox>
        </VBox>
    </content>
</DialogPane>
