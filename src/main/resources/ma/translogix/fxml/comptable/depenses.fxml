<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Expense approval ([C4]). Every figure comes from DepenseService and from real receipts.
     The shell provides the sidebar and the top bar (including "Imprimer", which prints the table). -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.comptable.DepensesController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="CONTR&#212;LE DES CHARGES DE ROUTE" styleClass="eyebrow"/>
            <Label text="Valider dépenses" styleClass="section-heading"/>
            <Label text="Vérifiez les reçus des chauffeurs, puis validez ou refusez chaque dépense de route."
                   styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonActualiser" text="Actualiser" onAction="#actualiser" styleClass="btn-secondary"/>
        <Button fx:id="boutonNouveau" text="Saisir une dépense" onAction="#nouveau" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
    </HBox>

    <HBox spacing="14">
        <VBox HBox.hgrow="ALWAYS" spacing="8" styleClass="kpi-card">
            <Label text="Dépenses en attente" styleClass="kpi-title"/>
            <Label fx:id="kpiEnAttente" text="0" styleClass="kpi-value"/>
            <Label text="À instruire par la comptabilité" styleClass="foot-muted"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="8" styleClass="kpi-card">
            <Label text="Montant en attente" styleClass="kpi-title"/>
            <Label fx:id="kpiMontantAttente" text="0 MAD" styleClass="kpi-value"/>
            <Label text="Total des reçus non encore validés" styleClass="foot-muted"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="8" styleClass="kpi-card">
            <Label text="Dépenses validées" styleClass="kpi-title"/>
            <Label fx:id="kpiValidees" text="0 MAD" styleClass="kpi-value"/>
            <Label text="Total retenu dans les charges" styleClass="foot-muted"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="8" styleClass="kpi-card">
            <Label text="Dépenses refusées" styleClass="kpi-title"/>
            <Label fx:id="kpiRefusees" text="0" styleClass="kpi-value"/>
            <Label text="Conservées dans l'historique avec leur motif" styleClass="foot-muted"/>
        </VBox>
    </HBox>

    <VBox styleClass="panel">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Reçus des chauffeurs" styleClass="panel-title"/>
                <Label text="Recherchez par mission, chauffeur, type ou lieu. Clic droit sur une ligne pour plus d'actions."
                       styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="recherche" promptText="Rechercher une dépense..." prefWidth="260"
                       styleClass="search-field"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 12 0;">
            <Label text="Statut" styleClass="muted"/>
            <ComboBox fx:id="filtreStatut" prefWidth="140"/>
            <Label text="Type" styleClass="muted"/>
            <ComboBox fx:id="filtreType" prefWidth="140"/>
            <Label text="Chauffeur" styleClass="muted"/>
            <ComboBox fx:id="filtreChauffeur" prefWidth="170"/>
            <Label text="Du" styleClass="muted"/>
            <DatePicker fx:id="filtreDu" prefWidth="130" promptText="Date début"/>
            <Label text="Au" styleClass="muted"/>
            <DatePicker fx:id="filtreAu" prefWidth="130" promptText="Date fin"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="boutonReset" text="Réinitialiser les filtres" onAction="#reinitialiser"
                    styleClass="btn-secondary" minWidth="-Infinity"/>
        </HBox>

        <TableView fx:id="table" fixedCellSize="52" prefHeight="420" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucune dépense ne correspond à la recherche." styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colMission" text="MISSION" prefWidth="180" minWidth="150"/>
                <TableColumn fx:id="colChauffeur" text="CHAUFFEUR" prefWidth="150" minWidth="120"/>
                <TableColumn fx:id="colType" text="TYPE" prefWidth="120" minWidth="100"/>
                <TableColumn fx:id="colStation" text="LIEU / STATION" prefWidth="180" minWidth="130"/>
                <TableColumn fx:id="colMontant" text="MONTANT" prefWidth="120" minWidth="105"/>
                <TableColumn fx:id="colDate" text="DATE REÇU" prefWidth="110" minWidth="100"/>
                <TableColumn fx:id="colStatut" text="STATUT" prefWidth="110" minWidth="95"/>
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="150" minWidth="145" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
