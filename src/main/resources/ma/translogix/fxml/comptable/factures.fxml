<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Client invoicing (contable.html #tab-invoices). Content only: the shell provides sidebar + top bar.
     Real data from FactureService (in-memory DAO). "Nouvelle facture" and "Régler" open dialogs. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.comptable.FacturesController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="VENTES &amp; CHIFFRE D'AFFAIRES" styleClass="eyebrow"/>
            <Label text="Facturation clients" styleClass="section-heading"/>
            <Label text="Suivi des factures de transport et des r&#232;glements." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonNouvelle" text="Nouvelle facture" onAction="#nouvelle" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
    </HBox>

    <VBox styleClass="panel">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Registre des factures" styleClass="panel-title"/>
                <Label text="Recherchez par N&#176; de facture, client ou montant. Clic droit sur une ligne pour plus d'actions." styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="recherche" promptText="Rechercher une facture..." prefWidth="280" styleClass="search-field"/>
        </HBox>
        <TableView fx:id="table" fixedCellSize="52" prefHeight="440" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucune facture ne correspond &#224; la recherche." styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colNumero" text="R&#201;F&#201;RENCE" prefWidth="115" minWidth="105"/>
                <TableColumn fx:id="colClient" text="CLIENT" prefWidth="170" minWidth="130"/>
                <TableColumn fx:id="colEmission" text="DATE &#201;MISSION" prefWidth="100" minWidth="90"/>
                <TableColumn fx:id="colEcheance" text="&#201;CH&#201;ANCE" prefWidth="95" minWidth="85"/>
                <TableColumn fx:id="colHt" text="MONTANT HT" prefWidth="115" minWidth="100"/>
                <TableColumn fx:id="colTva" text="TVA (14%)" prefWidth="100" minWidth="90"/>
                <TableColumn fx:id="colTtc" text="MONTANT TTC" prefWidth="120" minWidth="105"/>
                <TableColumn fx:id="colStatut" text="STATUT" prefWidth="105" minWidth="95"/>
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="135" minWidth="120" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
