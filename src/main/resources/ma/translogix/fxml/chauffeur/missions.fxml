<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root" styleClass="p-8" spacing="20.0" stylesheets="@../../css/translogix.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.translogix.chauffeur.controller.MissionsController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="eyebrow, pb-2" text="CARNET DE ROUTE" />
                  <Label styleClass="section-sub" text="Consultez vos ordres planifiés, en cours et l'historique des livraisons." />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#syncOrders" styleClass="btn-secondary" text="Synchroniser Ordres">
               <graphic>
                  <Label styleClass="fa, fs-12" text="&#xf2f9;" />
               </graphic>
            </Button>
         </children>
      </HBox>
      <VBox styleClass="panel">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="panel-head">
               <children>
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="h3" text="Liste des Missions Assignées" />
                        <Label styleClass="h3-sub" text="Recherchez par N° d'ordre, ville ou client." />
                     </children>
                  </VBox>
                  <TextField fx:id="searchField" maxWidth="320.0" prefWidth="320.0" promptText="Rechercher mission..." styleClass="search" />
               </children>
            </HBox>
            <TableView fx:id="table" styleClass="tbl">
               <columns>
                  <TableColumn fx:id="colRef" prefWidth="95.0" sortable="false" text="RÉF. ORDRE" />
                  <TableColumn fx:id="colRoute" prefWidth="178.0" sortable="false" text="ITINÉRAIRE" />
                  <TableColumn fx:id="colClient" prefWidth="132.0" sortable="false" text="CLIENT" />
                  <TableColumn fx:id="colCargo" prefWidth="132.0" sortable="false" text="CARGAISON" />
                  <TableColumn fx:id="colDate" prefWidth="142.0" sortable="false" text="DATE / HORAIRES" />
                  <TableColumn fx:id="colCmr" prefWidth="175.0" sortable="false" text="LETTRE DE VOITURE (CMR)" />
                  <TableColumn fx:id="colStatus" prefWidth="110.0" sortable="false" text="STATUT" />
                  <TableColumn fx:id="colAction" prefWidth="164.0" sortable="false" text="ACTION" />
               </columns>
               <placeholder>
                  <Label />
               </placeholder>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
