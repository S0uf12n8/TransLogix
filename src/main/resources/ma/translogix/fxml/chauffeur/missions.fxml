<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- "Mes Ordres de Transport" ([O3], docs/maquettes/chefaire.html tab-driver-missions).
     Only the logged-in driver's missions (EspaceChauffeurService); he can start or deliver them, nothing else.
     No price anywhere (ENF-03). The CMR column of the mockup is not built (no delivery notes yet). -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.chauffeur.MesMissionsController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="CARNET DE ROUTE" styleClass="eyebrow"/>
            <Label text="Mes Ordres de Transport" styleClass="section-heading"/>
            <Label text="Consultez vos ordres planifi&#233;s, en cours et l'historique des livraisons." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Synchroniser Ordres" onAction="#synchroniser" styleClass="btn-secondary"/>
    </HBox>

    <VBox styleClass="panel">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label fx:id="titreListe" text="Liste des Missions Assign&#233;es" styleClass="panel-title"/>
                <Label text="Recherchez par N&#176; d'ordre, ville ou client." styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="recherche" promptText="Rechercher mission..." prefWidth="260" styleClass="search-field"/>
        </HBox>
        <TableView fx:id="table" fixedCellSize="52" prefHeight="380" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label fx:id="vide" text="Aucune mission ne vous est affect&#233;e." wrapText="true"
                       styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colReference" text="R&#201;F. ORDRE" prefWidth="95" minWidth="90"/>
                <TableColumn fx:id="colItineraire" text="ITIN&#201;RAIRE" prefWidth="190" minWidth="160" sortable="false"/>
                <TableColumn fx:id="colClient" text="CLIENT" prefWidth="170" minWidth="140" sortable="false"/>
                <TableColumn fx:id="colCargaison" text="CARGAISON" prefWidth="150" minWidth="120" sortable="false"/>
                <TableColumn fx:id="colHoraires" text="DATE / HORAIRES" prefWidth="185" minWidth="170" sortable="false"/>
                <TableColumn fx:id="colStatut" text="STATUT" prefWidth="105" minWidth="100" sortable="false"/>
                <TableColumn fx:id="colAction" text="ACTION" prefWidth="100" minWidth="95" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
