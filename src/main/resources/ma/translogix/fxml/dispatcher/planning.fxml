<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- "Planning Chauffeurs" (dispatcher.html driver-assign). Hamid's DriverPlanningView, computed from real data:
     active drivers (EmployeService), their current or next mission (MissionService), licence (ConformiteService).
     The driving-time column is DÉMO: mission time today, no tachograph data before Iteration 3. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.dispatcher.PlanningController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="RESSOURCES &amp; DISPONIBILIT&#201;" styleClass="eyebrow"/>
            <Label text="Planning &amp; Affectation Chauffeurs" styleClass="section-heading"/>
            <Label text="Attribuez les conducteurs aux tracteurs et v&#233;rifiez le temps de conduite." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonAssigner" text="Assigner Chauffeur / Camion" onAction="#assigner" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
    </HBox>

    <VBox styleClass="panel">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Conducteurs &amp; Temps de Volant" styleClass="panel-title"/>
                <Label text="Respect du temps de repos r&#232;glementaire" styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Heures de conduite : D&#201;MO" styleClass="chip-demo"/>
        </HBox>
        <TableView fx:id="table" fixedCellSize="56" prefHeight="360" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucun chauffeur actif." styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colChauffeur" text="CHAUFFEUR" prefWidth="160" minWidth="145" sortable="false"/>
                <TableColumn fx:id="colCamion" text="CAMION ASSIGN&#201;" prefWidth="130" minWidth="120" sortable="false"/>
                <TableColumn fx:id="colMission" text="MISSION ACTUELLE / PROCHAINE" prefWidth="200" minWidth="185" sortable="false"/>
                <TableColumn fx:id="colPermis" text="PERMIS / VALIDIT&#201;" prefWidth="145" minWidth="135" sortable="false"/>
                <TableColumn fx:id="colHeures" text="HEURES CONDUITE (AUJ.)" prefWidth="160" minWidth="155" sortable="false"/>
                <TableColumn fx:id="colDisponibilite" text="DISPONIBILIT&#201;" prefWidth="110" minWidth="105" sortable="false"/>
                <TableColumn fx:id="colAction" text="ACTION" prefWidth="110" minWidth="105" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
