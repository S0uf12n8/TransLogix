<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- "Bons de Gazole & Cartes Autoroute" (dispatcher.html fuel-logs): Iteration 3. Hamid's FuelLogsView layout and
     sample vouchers, shown as DÉMO; "Émettre Bon Gazole" says "Module pas encore livré (itération 3)". -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.dispatcher.CarburantController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="GESTION CARBURANT &amp; P&#201;AGES" styleClass="eyebrow"/>
                <Label text="D&#201;MO" styleClass="chip-demo"/>
            </HBox>
            <Label text="Bons de Gazole &amp; Cartes Autoroute" styleClass="section-heading"/>
            <Label text="&#201;mission et suivi des bons de carburant par mission." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="&#201;mettre Bon Gazole" onAction="#emettre" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
    </HBox>

    <VBox styleClass="panel">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Historique des Ravitaillements" styleClass="panel-title"/>
                <Label text="Suivi des consommations moyennes par camion (donn&#233;es de d&#233;monstration)" styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="recherche" promptText="Rechercher bon, station, chauffeur..." prefWidth="280" styleClass="search-field"/>
        </HBox>
        <TableView fx:id="table" fixedCellSize="52" prefHeight="220" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucun bon ne correspond &#224; la recherche." styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colBon" text="N&#176; BON" prefWidth="95" minWidth="90" sortable="false"/>
                <TableColumn fx:id="colCamion" text="CAMION" prefWidth="100" minWidth="95" sortable="false"/>
                <TableColumn fx:id="colChauffeur" text="CHAUFFEUR" prefWidth="160" minWidth="140" sortable="false"/>
                <TableColumn fx:id="colStation" text="STATION / PROVIDER" prefWidth="230" minWidth="190" sortable="false"/>
                <TableColumn fx:id="colLitres" text="LITRES" prefWidth="70" minWidth="65" sortable="false"/>
                <TableColumn fx:id="colMontant" text="MONTANT EST." prefWidth="100" minWidth="95" sortable="false"/>
                <TableColumn fx:id="colStatut" text="STATUT" prefWidth="135" minWidth="130" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
