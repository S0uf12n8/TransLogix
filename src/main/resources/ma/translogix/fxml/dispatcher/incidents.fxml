<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- "Incidents & Retards de Route" (dispatcher.html incidents): Iteration 3. Hamid's IncidentsView layout,
     now filled from IncidentService; "Déclarer Incident" opens a modal validated by the service. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.dispatcher.IncidentsController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="GESTION DES AL&#201;AS" styleClass="eyebrow"/>
            <Label text="Incidents &amp; Retards de Route" styleClass="section-heading"/>
            <Label text="Signalez et g&#233;rez les pannes, accidents ou blocages." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonDeclarer" text="D&#233;clarer Incident" onAction="#declarer" styleClass="btn-danger"/>
    </HBox>

    <GridPane hgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox styleClass="card" spacing="14" GridPane.columnIndex="0">
            <HBox alignment="CENTER_LEFT">
                <Label text="Incidents En Cours" styleClass="panel-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="nombreOuverts" text="0 ouvert" styleClass="badge-red"/>
            </HBox>
            <TableView fx:id="tableIncidents" prefHeight="260" styleClass="flat-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Aucun incident d&#233;clar&#233;." styleClass="empty-placeholder"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colReference" text="N&#176; INCIDENT" prefWidth="100" minWidth="95" sortable="false"/>
                    <TableColumn fx:id="colMission" text="MISSION" prefWidth="90" minWidth="85" sortable="false"/>
                    <TableColumn fx:id="colType" text="TYPE" prefWidth="120" minWidth="110" sortable="false"/>
                    <TableColumn fx:id="colGravite" text="GRAVIT&#201;" prefWidth="85" minWidth="80" sortable="false"/>
                    <TableColumn fx:id="colDescription" text="DESCRIPTION" prefWidth="220" minWidth="180" sortable="false"/>
                    <TableColumn fx:id="colDate" text="SIGNAL&#201;" prefWidth="110" minWidth="100" sortable="false"/>
                    <TableColumn fx:id="colStatut" text="STATUT" prefWidth="90" minWidth="85" sortable="false"/>
                </columns>
            </TableView>
            <HBox spacing="14">
                <Button text="Appeler Assistance" onAction="#pasEncoreLivre" styleClass="link-red"/>
                <Button text="R&#233;soudre" onAction="#pasEncoreLivre" styleClass="link-green"/>
                <Button text="Pr&#233;venir Client" onAction="#pasEncoreLivre" styleClass="link-orange"/>
            </HBox>
        </VBox>

        <VBox styleClass="card" spacing="12" GridPane.columnIndex="1">
            <Label text="Proc&#233;dure d'Urgence Dispatch" styleClass="panel-title"/>
            <Label text="&#8226; Panne m&#233;canique : Contacter l'assistance 24/7 au 0800-XX-XX-XX et enregistrer la g&#233;olocalisation exacte."
                   wrapText="true" styleClass="incident-text"/>
            <Label text="&#8226; Accident de circulation : S'assurer de la s&#233;curit&#233; du chauffeur, demander un constat amiable ou rapport de gendarmerie."
                   wrapText="true" styleClass="incident-text"/>
            <Label text="&#8226; Rupture de cha&#238;ne du froid : Contacter imm&#233;diatement le client et consigner la temp&#233;rature enregistr&#233;e."
                   wrapText="true" styleClass="incident-text"/>
        </VBox>
    </GridPane>
</VBox>
