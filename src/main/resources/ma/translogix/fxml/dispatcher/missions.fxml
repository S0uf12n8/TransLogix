<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- "Ordres & Trajets" (dispatcher.html active-orders, issue [H5]). Layout, wording and column order from
     Hamid's OrdersView.fxml. Missions, vehicles and drivers are real (MissionService, in memory);
     "En attente de quai" and "Alertes Retard / Incidents" stay DÉMO (incidents arrive in Iteration 3). -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.translogix.controller.dispatcher.MissionsController"
      stylesheets="@../../css/app.css"
      spacing="20" styleClass="page">

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="6">
            <Label text="SUIVI OP&#201;RATIONNEL" styleClass="eyebrow"/>
            <Label text="Tableau de Dispatching" styleClass="section-heading"/>
            <Label text="Gestion en temps r&#233;el des d&#233;parts, livraisons et affectations." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Exporter la feuille de route" onAction="#exporter" styleClass="btn-secondary"/>
        <Button fx:id="boutonNouvelle" text="Nouvelle affectation" onAction="#nouvelle" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" styleClass="btn-icon-white"/>
            </graphic>
        </Button>
    </HBox>

    <GridPane hgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <VBox styleClass="card" spacing="10" GridPane.columnIndex="0">
            <Label text="Missions en cours" styleClass="kpi-title"/>
            <HBox alignment="BASELINE_LEFT" spacing="6">
                <Label fx:id="valeurEnCours" text="0" styleClass="kpi-value"/>
                <Label text="camions" styleClass="kpi-unit"/>
            </HBox>
            <Label fx:id="piedEnCours" text="&#8212;" styleClass="foot-blue"/>
        </VBox>

        <VBox styleClass="card" spacing="10" GridPane.columnIndex="1">
            <Label text="Camions dispo" styleClass="kpi-title"/>
            <HBox alignment="BASELINE_LEFT" spacing="6">
                <Label fx:id="valeurDispo" text="0" styleClass="kpi-value"/>
                <Label fx:id="totalVehicules" text="/ 0" styleClass="kpi-unit"/>
            </HBox>
            <ProgressBar fx:id="progressionDispo" progress="0" maxWidth="Infinity" styleClass="kpi-progress"/>
            <Label text="Pr&#234;ts pour affectation" styleClass="foot-muted"/>
        </VBox>

        <VBox styleClass="card" spacing="10" GridPane.columnIndex="2">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="En attente de quai" styleClass="kpi-title"/>
                <Label text="D&#201;MO" styleClass="chip-demo"/>
            </HBox>
            <HBox alignment="BASELINE_LEFT" spacing="6">
                <Label text="4" styleClass="kpi-value"/>
                <Label text="chargements" styleClass="kpi-unit"/>
            </HBox>
            <Label text="Port de Casablanca" styleClass="foot-amber"/>
        </VBox>

        <VBox styleClass="card" spacing="10" GridPane.columnIndex="3">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Alertes Retard / Incidents" styleClass="kpi-title"/>
                <Label text="D&#201;MO" styleClass="chip-demo"/>
            </HBox>
            <HBox alignment="BASELINE_LEFT" spacing="6">
                <Label text="2" styleClass="kpi-value"/>
                <Label text="cas" styleClass="kpi-unit"/>
            </HBox>
            <Label text="1 panne mineure + 1 retard" styleClass="foot-red"/>
        </VBox>
    </GridPane>

    <VBox styleClass="panel">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Ordres de Transport Actifs" styleClass="panel-title"/>
                <Label text="Consultez et modifiez les missions programm&#233;es" styleClass="panel-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Multi-criteria search: every filter is combined with the others (AND). -->
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <TextField fx:id="recherche" promptText="R&#233;f. mission (TRJ-...)" prefWidth="150"
                           styleClass="search-field"/>
                <TextField fx:id="filtreChauffeur" promptText="Chauffeur..." prefWidth="140"
                           styleClass="search-field"/>
                <TextField fx:id="filtreVille" promptText="Ville..." prefWidth="140"
                           styleClass="search-field"/>
            </HBox>
        </HBox>
        <TableView fx:id="table" fixedCellSize="56" prefHeight="380" styleClass="flat-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucune mission ne correspond &#224; la recherche." styleClass="empty-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colReference" text="R&#201;F. MISSION" prefWidth="90" minWidth="85"/>
                <TableColumn fx:id="colChauffeur" text="CHAUFFEUR &amp; CAMION" prefWidth="170" minWidth="155" sortable="false"/>
                <TableColumn fx:id="colItineraire" text="ITIN&#201;RAIRE" prefWidth="175" minWidth="155" sortable="false"/>
                <TableColumn fx:id="colCargaison" text="CARGAISON" prefWidth="135" minWidth="115" sortable="false"/>
                <TableColumn fx:id="colEta" text="ETA / ARRIV&#201;E PR&#201;V." prefWidth="140" minWidth="135" sortable="false"/>
                <TableColumn fx:id="colStatut" text="STATUT" prefWidth="100" minWidth="95" sortable="false"/>
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="225" minWidth="225" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
