<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Login screen ([O2], docs/maquettes/login.html): dark card on a light background, orange button.
     Fields and controller from Hiba's version; the check itself is in AuthService.
     Not reproduced from the mockup: the demo role tabs, "Mot de passe oublié", "Se souvenir de cet appareil"
     and the logo upload. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="ma.translogix.controller.auth.LoginController"
           stylesheets="@../../css/app.css"
           styleClass="login-root">

    <VBox alignment="CENTER" spacing="18" maxWidth="440" maxHeight="-Infinity">
        <VBox styleClass="login-card" spacing="14">
            <VBox alignment="CENTER" spacing="6">
                <StackPane styleClass="login-logo" minWidth="64" minHeight="64" maxWidth="64" maxHeight="64">
                    <SVGPath fillRule="EVEN_ODD" styleClass="login-logo-icon"
                             content="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                </StackPane>
                <Label text="TRANSLOGIX" styleClass="login-title"/>
                <Label text="Plateforme de gestion logistique &amp; transport · Maroc" styleClass="login-sub"/>
            </VBox>

            <Region minHeight="4"/>
            <VBox spacing="6">
                <Label text="Identifiant ou e-mail professionnel" styleClass="login-label"/>
                <TextField fx:id="emailField" promptText="nom@translogix.ma" styleClass="login-field"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Mot de passe" styleClass="login-label"/>
                <PasswordField fx:id="passwordField" promptText="Votre mot de passe" styleClass="login-field"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="login-error" wrapText="true" maxWidth="Infinity"
                   visible="false" managed="false"/>

            <!-- defaultButton: Enter submits from either field. -->
            <Button text="SE CONNECTER  →" onAction="#connecter" defaultButton="true" maxWidth="Infinity"
                    styleClass="login-button"/>
        </VBox>
        <Label text="TransLogix · gestion des opérations de transport" styleClass="login-footer"/>
    </VBox>
</StackPane>
