<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="root" prefHeight="900.0" prefWidth="1440.0" stylesheets="@../css/translogix.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.translogix.chauffeur.controller.MainController">
   <children>
      <BorderPane fx:id="appLayout">
         <!-- ===================== SIDEBAR ===================== -->
         <left>
            <VBox fx:id="sidebar" minWidth="258.0" prefWidth="258.0" maxWidth="258.0" styleClass="sidebar">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="sidebar-logo">
                     <children>
                        <StackPane minHeight="44.0" minWidth="44.0" prefHeight="44.0" prefWidth="44.0" maxHeight="44.0" maxWidth="44.0" styleClass="logo-box">
                           <children>
                              <Label styleClass="fa" text="&#xe2b7;" />
                           </children>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="sidebar-title" text="Espace Chauffeur" />
                              <Label styleClass="sidebar-sub" text="TRANSLOGIX · MAROC" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <VBox styleClass="p-4">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="user-card">
                           <children>
                              <StackPane minHeight="36.0" minWidth="36.0" prefHeight="36.0" prefWidth="36.0" maxHeight="36.0" maxWidth="36.0" styleClass="avatar-sm">
                                 <children>
                                    <Label text="MB" />
                                 </children>
                              </StackPane>
                              <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="fs-12, fw-b, c-white" text="Mohammed Bennani" />
                                    <Label styleClass="fs-10, c-s400, pt-1" text="Chauffeur Routier PL (EC)" />
                                 </children>
                              </VBox>
                              <Circle radius="4.0" styleClass="online-dot" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox spacing="4.0">
                           <padding>
                              <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
                           </padding>
                           <children>
                              <Label styleClass="nav-eyebrow" text="POSTE DE CONDUITE">
                                 <padding>
                                    <Insets bottom="8.0" left="12.0" right="12.0" top="4.0" />
                                 </padding>
                              </Label>
                              <ToggleButton fx:id="navHome" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" selected="true" styleClass="nav-item" userData="driver-home">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="navGroup" />
                                 </toggleGroup>
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="fa, nav-icon" text="&#xe066;" />
                                          <Label styleClass="nav-text" text="Tableau de bord" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton fx:id="navMissions" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" styleClass="nav-item" toggleGroup="$navGroup" userData="driver-missions">
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="fa, nav-icon" text="&#xf4d7;" />
                                          <Label minWidth="-Infinity" styleClass="nav-text" text="Mes Ordres de&#10;Transport" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label minWidth="-Infinity" styleClass="nav-badge, nav-badge-orange" text="1 en cours" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton fx:id="navExpenses" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" styleClass="nav-item" toggleGroup="$navGroup" userData="driver-expenses">
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="fa, nav-icon" text="&#xf543;" />
                                          <Label styleClass="nav-text" text="Reçus &amp; Carburant" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="driverExpenseBadge" minWidth="-Infinity" styleClass="nav-badge, nav-badge-emerald" text="2" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton fx:id="navProfile" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" styleClass="nav-item" toggleGroup="$navGroup" userData="driver-profile">
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="fa, nav-icon" text="&#xf2bb;" />
                                          <Label styleClass="nav-text" text="Permis &amp; Documents" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton fx:id="navIncidents" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" styleClass="nav-item" toggleGroup="$navGroup" userData="driver-incidents">
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="fa, nav-icon" text="&#xf071;" />
                                          <Label styleClass="nav-text" text="Incidents &amp; Support" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <Label styleClass="nav-eyebrow" text="MISSION &amp; SÉCURITÉ">
                                 <padding>
                                    <Insets bottom="8.0" left="12.0" right="12.0" top="16.0" />
                                 </padding>
                              </Label>
                              <ToggleButton fx:id="navNotifications" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" styleClass="nav-item" toggleGroup="$navGroup" userData="driver-notifications">
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="far, nav-icon" text="&#xf0f3;" />
                                          <Label styleClass="nav-text" text="Notifications" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="navNotifBadge" minWidth="-Infinity" styleClass="nav-badge, nav-badge-orange" text="0" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton fx:id="navMissionDetail" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" styleClass="nav-item" toggleGroup="$navGroup" userData="driver-mission-detail">
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="fa, nav-icon" text="&#xf0ae;" />
                                          <Label styleClass="nav-text" text="Détail &amp; Suivi mission" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton fx:id="navPod" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" styleClass="nav-item" toggleGroup="$navGroup" userData="driver-pod">
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="fa, nav-icon" text="&#xf573;" />
                                          <Label styleClass="nav-text" text="Preuve de livraison" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton fx:id="navInspection" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" styleClass="nav-item" toggleGroup="$navGroup" userData="driver-inspection">
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="fa, nav-icon" text="&#xf46c;" />
                                          <Label styleClass="nav-text" text="Inspection du camion" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton fx:id="navChat" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" styleClass="nav-item" toggleGroup="$navGroup" userData="driver-chat">
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="fa, nav-icon" text="&#xf086;" />
                                          <Label styleClass="nav-text" text="Messagerie Dispatching" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton fx:id="navExceptional" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" styleClass="nav-item" toggleGroup="$navGroup" userData="driver-exceptional">
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="fa, nav-icon" text="&#xf1cd;" />
                                          <Label styleClass="nav-text" text="Intervention exceptionnelle" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton fx:id="navHistory" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNavClick" styleClass="nav-item" toggleGroup="$navGroup" userData="driver-history">
                                 <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="fa, nav-icon" text="&#xf1da;" />
                                          <Label styleClass="nav-text" text="Historique des missions" />
                                       </children>
                                    </HBox>
                                 </graphic>
                              </ToggleButton>
                              <VBox styleClass="truck-card">
                                 <VBox.margin>
                                    <Insets top="20.0" />
                                 </VBox.margin>
                                 <children>
                                    <Label styleClass="fa, c-o300, fs-16" text="&#xe2b7;">
                                       <padding>
                                          <Insets bottom="8.0" />
                                       </padding>
                                    </Label>
                                    <Label styleClass="fs-12, fw-6, c-white" text="Camion Assigné" />
                                    <TextFlow lineSpacing="3.0">
                                       <padding>
                                          <Insets top="4.0" />
                                       </padding>
                                       <children>
                                          <Text style="-fx-fill: #94a3b8; -fx-font-size: 10px; -fx-font-weight: bold;" text="Volvo FH 500" />
                                          <Text style="-fx-fill: #94a3b8; -fx-font-size: 10px;" text=" · 12345-A-6&#10;Prochaine vidange : 425 000 km" />
                                       </children>
                                    </TextFlow>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
                  <VBox styleClass="sidebar-foot">
                     <children>
                        <Button fx:id="logoutButton" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#logout" styleClass="nav-item, nav-logout">
                           <graphic>
                              <HBox alignment="CENTER_LEFT" prefWidth="208.0" spacing="12.0">
                                 <children>
                                    <Label styleClass="fa, nav-icon" text="&#xf2f5;" />
                                    <Label styleClass="nav-text" text="Fin de service" />
                                 </children>
                              </HBox>
                           </graphic>
                        </Button>
                        <Label styleClass="sidebar-ver" text="Espace Chauffeur v2.0 · Démo">
                           <VBox.margin>
                              <Insets top="12.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </left>
         <!-- ===================== ZONE PRINCIPALE ===================== -->
         <center>
            <VBox>
               <children>
                  <!-- En-tête -->
                  <HBox alignment="CENTER_LEFT" maxHeight="72.0" minHeight="72.0" prefHeight="72.0" spacing="16.0" styleClass="topbar">
                     <children>
                        <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="pageKicker" styleClass="eyebrow" text="COCKPIT CHAUFFEUR" />
                              <Label fx:id="pageTitle" styleClass="fs-16, fw-b" text="Tableau de bord" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT">
                           <children>
                              <Label fx:id="currentDate" styleClass="fs-12, fw-6, c-s700" />
                              <Label styleClass="fs-10, c-s400, pt-1" text="Trajet : Casablanca → Tanger Med" />
                           </children>
                        </VBox>
                        <Button mnemonicParsing="false" onAction="#openExpenseModal" styleClass="btn-primary" text="Ajouter Reçu">
                           <graphic>
                              <Label styleClass="fa, fs-12" text="&#xf52f;" />
                           </graphic>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#exportDriverReport" styleClass="btn-secondary" text="Export Relevé">
                           <graphic>
                              <Label styleClass="fa, fs-12" text="&#xf6dd;" />
                           </graphic>
                        </Button>
                        <StackPane>
                           <children>
                              <Button focusTraversable="false" mnemonicParsing="false" onAction="#openNotificationsTab" styleClass="bell-btn">
                                 <graphic>
                                    <Label styleClass="far" text="&#xf0f3;" />
                                 </graphic>
                              </Button>
                              <Circle fx:id="notifDot" mouseTransparent="true" radius="4.0" styleClass="notif-dot" StackPane.alignment="TOP_RIGHT">
                                 <StackPane.margin>
                                    <Insets right="6.0" top="6.0" />
                                 </StackPane.margin>
                              </Circle>
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <!-- Contenu défilant -->
                  <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                     <content>
                        <StackPane alignment="TOP_CENTER">
                           <children>
                              <VBox maxWidth="1600.0" styleClass="p-8">
                                 <children>
                                    <StackPane fx:id="sectionHost" alignment="TOP_LEFT">
                                       <children>
                                          <fx:include fx:id="dashboard" source="../ma/translogix/fxml/chauffeur/dashboard.fxml" />
                                          <fx:include fx:id="missions" source="../ma/translogix/fxml/chauffeur/missions.fxml" />
                                          <fx:include fx:id="expenses" source="../ma/translogix/fxml/chauffeur/expenses.fxml" />
                                          <fx:include fx:id="profile" source="../ma/translogix/fxml/chauffeur/profile.fxml" />
                                          <fx:include fx:id="incidents" source="../ma/translogix/fxml/chauffeur/incidents.fxml" />
                                          <fx:include fx:id="notifications" source="../ma/translogix/fxml/chauffeur/notifications.fxml" />
                                          <fx:include fx:id="missionDetail" source="../ma/translogix/fxml/chauffeur/mission-detail.fxml" />
                                          <fx:include fx:id="pod" source="../ma/translogix/fxml/chauffeur/pod.fxml" />
                                          <fx:include fx:id="inspection" source="../ma/translogix/fxml/chauffeur/inspection.fxml" />
                                          <fx:include fx:id="chat" source="../ma/translogix/fxml/chauffeur/chat.fxml" />
                                          <fx:include fx:id="exceptional" source="../ma/translogix/fxml/chauffeur/exceptional.fxml" />
                                          <fx:include fx:id="history" source="../ma/translogix/fxml/chauffeur/history.fxml" />
                                       </children>
                                    </StackPane>
                                    <Label alignment="CENTER" maxWidth="Infinity" styleClass="footer" text="© 2026 Translogix ERP · Espace Chauffeur · Démonstration sans persistance." />
                                 </children>
                              </VBox>
                           </children>
                        </StackPane>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </center>
      </BorderPane>
      <!-- ===================== TOAST ===================== -->
      <StackPane fx:id="toastLayer" mouseTransparent="true" pickOnBounds="false">
         <children>
            <HBox fx:id="toast" alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="toast" visible="false" StackPane.alignment="BOTTOM_RIGHT">
               <StackPane.margin>
                  <Insets bottom="20.0" right="20.0" />
               </StackPane.margin>
               <children>
                  <Label fx:id="toastLabel" maxWidth="352.0" styleClass="toast-text" wrapText="true" />
               </children>
            </HBox>
         </children>
      </StackPane>
      <!-- ===================== MODALE ===================== -->
      <StackPane fx:id="modalOverlay" styleClass="modal-overlay" visible="false">
         <children>
            <StackPane fx:id="modalHost" maxHeight="-Infinity" maxWidth="-Infinity" minWidth="0.0" prefWidth="480.0" styleClass="modal-card" />
         </children>
      </StackPane>
   </children>
</StackPane>
